# Copy to .env and adjust. Local Postgres and Redis via: docker compose up -d

DATABASE_URL="postgresql://sworg:sworg_dev@localhost:5432/sworg_dev"
# Direct (non-pooled) connection used only by Prisma migrations. Locally it is the
# same database; behind a transaction pooler it bypasses the pooler.
# The `npm run db:*` scripts fall back to DATABASE_URL when this is unset.
DIRECT_URL="postgresql://sworg:sworg_dev@localhost:5432/sworg_dev"

# Redis (rate limits and the BullMQ job queues). Required in production, where it must use TLS (rediss://).
REDIS_URL="redis://localhost:6379"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# For localhost-only development, set this to http://localhost:3000. Set both in production.
# AUTH_URL="http://localhost:3000"
# Canonical origin used in generated links (receipts, cards, emails). In production it must
# exactly match AUTH_URL, including the HTTPS scheme.
# NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Shown in the site footer as "Hosted by …". Leave empty to hide it.
# NEXT_PUBLIC_HOSTED_BY="Shaan Shoukath, Systems Engineer"

# Production only: 1 allows an http:// AUTH_URL/NEXT_PUBLIC_BASE_URL (LAN or trial install).
# ALLOW_PLAIN_HTTP="0"

# Comma-separated trusted CDN/reverse-proxy hostnames allowed to invoke Server Actions.
ALLOWED_ACTION_ORIGINS=""
# Select only a header your edge proxy overwrites. Cloudflare users keep this default.
# Bundled stack behind a Cloudflare Tunnel: set CLOUDFLARE_TUNNEL_TOKEN in the install's .env (SWO_LAYER=cloudflared);
# the overlay sets cf-connecting-ip for the app, and the token is never an app variable.
TRUSTED_PROXY_IP_HEADER="cf-connecting-ip"
# With x-forwarded-for: how many trusted proxies append to it (default 1).
TRUSTED_PROXY_HOPS=""

# Sign-in provider fallbacks. Prefer Super admin → Settings; values saved there win and are encrypted.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Apple: services ID, team ID, key ID and the .p8 key with newlines written as 
.
AUTH_APPLE_ID=""
AUTH_APPLE_TEAM_ID=""
AUTH_APPLE_KEY_ID=""
AUTH_APPLE_PRIVATE_KEY=""
# Sign-in methods this deployment offers (comma list of password,google,apple,github,oidc,saml,supabase,firebase). Only password is on by default. When set it
# overrides the Super admin switches (shown there as "set by the server"); unset leaves them to Super admin.
LOGIN_METHODS=""
# Supabase Auth bridge (public values only). The project must use asymmetric JWT signing keys, not the legacy secret.
AUTH_SUPABASE_URL=""
AUTH_SUPABASE_ANON_KEY=""
# Comma list: email (a magic link) and/or OAuth providers enabled in the project, for example email,google,github.
AUTH_SUPABASE_PROVIDERS="email"
# Firebase Auth bridge (public web app values only).
AUTH_FIREBASE_API_KEY=""
AUTH_FIREBASE_AUTH_DOMAIN=""
AUTH_FIREBASE_PROJECT_ID=""
AUTH_FIREBASE_APP_ID=""
# Comma list: google.com, microsoft.com, apple.com, github.com, facebook.com, twitter.com, yahoo.com, emailLink, password.
AUTH_FIREBASE_PROVIDERS="google.com"

# Comma-separated hosts allowed to request dev assets, for example a LAN IP.
# NEXT_DEV_ALLOWED_ORIGINS="192.168.1.6"

# Email fallback. Prefer Super admin → Settings; values saved there win.
EMAIL_FROM="Space Works Organization <noreply@localhost>"
SMTP_SERVICE=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Set to 1 only for an intentionally unauthenticated private SMTP relay.
SMTP_ALLOW_UNAUTHENTICATED="0"
# Email provider: smtp (default), ses, resend or postmark. Off until its fields are set; Super admin -> Settings wins.
EMAIL_PROVIDER="smtp"
# Amazon SES (AWS_REGION is used when AWS_SES_REGION is empty). SES_TOPIC_ARN pins the SNS topic bounce reports come from.
AWS_SES_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""
SES_TOPIC_ARN=""
RESEND_API_KEY=""
POSTMARK_SERVER_TOKEN=""
POSTMARK_MESSAGE_STREAM="outbound"
# Resend signing secret (whsec_...) or the password Postmark's webhook sends with basic auth.
EMAIL_WEBHOOK_SECRET=""

# SMS provider for phone sign-in codes: twilio or msg91. Off until its fields are set; Super admin -> Auth wins.
SMS_PROVIDER=""
# Twilio: the account SID with the auth token (or an API key SID and secret), and a from number or messaging service SID.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_API_KEY_SID=""
TWILIO_API_KEY_SECRET=""
TWILIO_FROM=""
TWILIO_MESSAGING_SERVICE_SID=""
# MSG91 (Flow API): auth key, DLT template id (variables otp and brand) and sender id.
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""
# The token MSG91's delivery report address carries (?token=). Twilio reports are verified by its signature instead.
SMS_WEBHOOK_SECRET=""
# Most phone codes asked for numbers of one country calling code in a day, across the install (default 500).
SMS_DAILY_COUNTRY_CAP=""

# Member messaging: Mattermost hosts you trust even though they resolve to private addresses (comma-separated), and how long
# the message log (what was sent through which channel, never the text) is kept in days (default 90).
MESSAGING_MATTERMOST_HOSTS=""
MESSAGE_LOG_RETENTION_DAYS=""

# Secret for the external-cron hooks POST /api/internal/outbox and /api/internal/jobs
# (hosts without a beat process). Generate: openssl rand -base64 32
CRON_SECRET=""
# Background jobs run in the worker and beat roles (npm run worker / npm run beat after npm run build:jobs).
# JOBS_QUEUE_PREFIX="swo:jobs"
# JOBS_HEALTH_PORT="3460"
# Jobs each worker runs at once, per queue (1 to 64).
# QUEUE_OUTBOX_CONCURRENCY="5"
# QUEUE_SCHEDULED_CONCURRENCY="2"
# Development without Redis (REDIS_URL unset): "true" runs the periodic jobs from a one-minute timer in the web process.
# JOBS_INPROCESS="false"
OUTBOX_RETENTION_DAYS="30"
# Readiness probe secret for GET /api/health/db.
HEALTHCHECK_SECRET=""

# Valid base64 for a 16, 24 or 32-byte AES key. Stable across every container serving one build.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
# Independent 32-byte AES key for authenticator seeds at rest.
MFA_ENCRYPTION_KEY=""
# Independent 32-byte AES-GCM key (base64) for payment gateway secrets at rest. Back it up:
# without it, saved Razorpay/Stripe keys cannot be read. Generate: openssl rand -base64 32
PAYMENT_SECRETS_KEY=""

# Private S3-compatible object storage (Silo on a VPS; R2 or any S3 in the cloud).
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="0"

# The first super admin. The installer creates it with a password; super admins are managed only on the
# server (bash scripts/admin.sh), never by email or in the app.
SUPER_ADMIN_EMAIL=""

# New passwords are checked against known breaches (Have I Been Pwned, k-anonymity: only a 5-character hash
# prefix leaves the server). Set to 0 on installs without internet access.
PWNED_PASSWORDS_CHECK="1"

# Backup posture fallback shown in Super admin → Settings.
BACKUP_PROVIDER=""
BACKUP_LAST_SUCCESS_AT=""
BACKUP_RETENTION_DAYS="30"

# Optional split hosting (frontend on Netlify, backend on a VPS). Leave unset for one container.
# Backend: DEPLOYMENT_MODE=backend; an independent 32-byte random hex gateway key.
# DEPLOYMENT_MODE="backend"
FRONTEND_GATEWAY_SECRET=""
# Frontend only: canonical backend origin (no path or trailing slash).
BACKEND_ORIGIN=""
NEXT_PUBLIC_BACKEND_ORIGIN=""

# The landing page at / (product rules 12.1). false: / opens the one public organisation, the organisations list,
# or sign-in (12.2). Runtime value; set the same on the backend and the website.
LANDING_ENABLED="true"

# Optional outside web analytics for the public pages (product rules section 8). Off unless set here AND configured in
# Super admin -> Settings, and only after a visitor agrees. Runtime values, never NEXT_PUBLIC_. Set the same on the
# backend and the website. Comma-separated bare https origins the policy may widen for (script hosts, collectors).
WEB_TELEMETRY_ALLOWED_ORIGINS=""
# Mixpanel (optional, replaces the page analytics provider while the token is set). Hosts default to Mixpanel's own.
WEB_TELEMETRY_MIXPANEL_TOKEN=""
WEB_TELEMETRY_MIXPANEL_API_HOST=""
WEB_TELEMETRY_MIXPANEL_SDK_HOST=""
# Netlify: x-nf-client-connection-ip. Your own trusted proxy: x-real-ip.
FRONTEND_TRUSTED_IP_HEADER=""

# Legacy aliases, still read when the AUTH_* names are empty: GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET (for AUTH_GOOGLE_ID
# and AUTH_GOOGLE_SECRET). Prefer the AUTH_* names.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# CI only: lets the production-mode test suite run without TLS database and Redis URLs. Never set on a server.
# ALLOW_INSECURE_PRODUCTION_TESTS="1"
