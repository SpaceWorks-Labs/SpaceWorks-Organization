# Production settings, read by scripts/spaceworks-compose.sh. Every value is a placeholder.
#   bundled  the curl installer / setup.sh writes the install's .env for you (owner-only).
#            This file documents it; edit that .env only to change a setting, then run
#            scripts/spaceworks-compose.sh bundled up -d.
#   cloud    copy this file to /etc/spaceworks-organization/cloud.env (chmod 600), fill it,
#            then run scripts/spaceworks-compose.sh cloud up -d. See docs/DEPLOYMENT_CLOUD.md.
# Every variable is described in docs/CONFIGURATION.md. Single quotes keep values literal.

# --- Release and layout (bundled) ---
SWO_REPOSITORY='SpaceWorks-Labs/SpaceWorks-Organization'
SWO_BACKEND_IMAGE='ghcr.io/spaceworks-labs/spaceworks-organization-backend'
SWO_FRONTEND_IMAGE='ghcr.io/spaceworks-labs/spaceworks-organization-frontend'
# none = plain HTTP through Caddy; tls = automatic HTTPS (Let's Encrypt); proxy = your own proxy on 127.0.0.1:8080;
# cloudflared = Cloudflare Tunnel, no published ports (docs/DEPLOYMENT_CLOUDFLARE.md)
SWO_LAYER='none'
# With SWO_LAYER='cloudflared': the tunnel's connector token (secret; used only by the cloudflared service).
# CLOUDFLARE_TUNNEL_TOKEN='replace-with-the-connector-token'
# bundled = Silo on this server; external = the S3_* bucket below
SWO_STORAGE='bundled'

# --- Public address ---
PUBLIC_APP_BASE_URL='https://members.example.org'
# Caddy's site: the domain for automatic HTTPS, or http://<host> for plain HTTP.
SITE_ADDRESS='members.example.org'
TLS_EMAIL='ops@example.org'
HTTP_PORT='80'
# Only for a LAN or trial install on plain HTTP.
# ALLOW_PLAIN_HTTP='1'
# Backend for a Netlify website (docs/DEPLOYMENT_NETLIFY.md): DEPLOYMENT_MODE='backend' and a 64-hex secret.
# DEPLOYMENT_MODE='backend'
# FRONTEND_GATEWAY_SECRET='replace-with-openssl-rand-hex-32'

# --- Bundled data services (generated by setup.sh; alphanumeric) ---
POSTGRES_PASSWORD='replace-with-a-long-random-alphanumeric'
POSTGRES_APP_PASSWORD='replace-with-another-long-random-alphanumeric'
REDIS_PASSWORD='replace-with-a-long-random-alphanumeric'
MINIO_ROOT_USER='sworg-root'
MINIO_ROOT_PASSWORD='replace-with-a-long-random-alphanumeric'
S3_APP_PASSWORD='replace-with-a-long-random-alphanumeric'
# Scheduled backups into backups/ (database dump and bucket mirror).
BACKUP_INTERVAL_HOURS='24'
BACKUP_RETENTION_DAYS='14'

# --- Managed services (cloud; or an external bucket with SWO_STORAGE='external') ---
DATABASE_URL='postgresql://user:password@db.example.org:6543/postgres?sslmode=require&pgbouncer=true'
DIRECT_URL='postgresql://user:password@db.example.org:5432/postgres?sslmode=require'
REDIS_URL='rediss://default:password@redis.example.org:6379'
S3_ENDPOINT='https://account-id.r2.cloudflarestorage.com'
S3_REGION='auto'
S3_BUCKET='spaceworks-organization'
S3_ACCESS_KEY_ID='replace-with-the-bucket-access-key'
S3_SECRET_ACCESS_KEY='replace-with-the-bucket-secret-key'
# Cloud only: the header your platform's edge overwrites with the client address.
TRUSTED_PROXY_IP_HEADER='x-forwarded-for'
# With x-forwarded-for: how many trusted proxies append to it (default 1).
# TRUSTED_PROXY_HOPS='1'
APP_BIND='127.0.0.1'
APP_PORT='8080'

# --- Application secrets (generated by setup.sh) ---
AUTH_SECRET='replace-with-openssl-rand-base64-48'
CRON_SECRET='replace-with-openssl-rand-base64-48'
HEALTHCHECK_SECRET='replace-with-openssl-rand-base64-48'
# Base64 of exactly 32 random bytes each (openssl rand -base64 32); never change them once in use.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY='MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY='
MFA_ENCRYPTION_KEY='MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY='
PAYMENT_SECRETS_KEY='MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY='

# --- People and email ---
SUPER_ADMIN_EMAIL='admin@example.org'
# Check new passwords against known breaches (only a 5-character hash prefix leaves the server); 0 turns it off.
PWNED_PASSWORDS_CHECK='1'
EMAIL_FROM='Space Works Organization <noreply@example.org>'
SMTP_HOST='smtp-relay.brevo.com'
SMTP_PORT='587'
SMTP_SECURE='false'
SMTP_USER='replace-with-the-smtp-login'
SMTP_PASSWORD='replace-with-the-smtp-key'
# Or another email provider instead of SMTP: EMAIL_PROVIDER='ses' | 'resend' | 'postmark' (SMTP is the default).
# EMAIL_PROVIDER='resend'
# SMTP_SERVICE=''
# SMTP_ALLOW_UNAUTHENTICATED='0'
# RESEND_API_KEY=''
# POSTMARK_SERVER_TOKEN=''
# POSTMARK_MESSAGE_STREAM='outbound'
# AWS_SES_REGION='eu-west-1'
# AWS_ACCESS_KEY_ID=''
# AWS_SECRET_ACCESS_KEY=''
# AWS_SESSION_TOKEN=''
# SES_TOPIC_ARN=''
# EMAIL_WEBHOOK_SECRET=''

# --- Optional: phone sign-in codes by SMS (SMS_PROVIDER='twilio' | 'msg91'; also in Super admin -> Auth) ---
# SMS_PROVIDER='twilio'
# TWILIO_ACCOUNT_SID=''
# TWILIO_AUTH_TOKEN=''
# TWILIO_API_KEY_SID=''
# TWILIO_API_KEY_SECRET=''
# TWILIO_FROM=''
# TWILIO_MESSAGING_SERVICE_SID=''
# MSG91_AUTH_KEY=''
# MSG91_SENDER_ID=''
# MSG91_TEMPLATE_ID=''
# SMS_WEBHOOK_SECRET=''
# SMS_DAILY_COUNTRY_CAP='500'

# --- Member messaging (optional) ---
# MESSAGING_MATTERMOST_HOSTS=''
# MESSAGE_LOG_RETENTION_DAYS='90'

# --- Optional sign-in providers (also configurable in Super admin -> Settings) ---
# AUTH_GOOGLE_ID='1234-abc.apps.googleusercontent.com'
# AUTH_GOOGLE_SECRET=''
# AUTH_GITHUB_ID=''
# AUTH_GITHUB_SECRET=''
# AUTH_APPLE_ID=''
# AUTH_APPLE_TEAM_ID=''
# AUTH_APPLE_KEY_ID=''
# AUTH_APPLE_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
'
# The deployment's own list of sign-in methods; when set it overrides the Super admin switches.
# LOGIN_METHODS='password,google,apple,github,oidc,saml,supabase,firebase'
# Supabase Auth bridge (public values; asymmetric JWT signing keys only) and Firebase Auth bridge (public web app values)
# AUTH_SUPABASE_URL='https://<project-ref>.supabase.co'
# AUTH_SUPABASE_ANON_KEY=''
# AUTH_SUPABASE_PROVIDERS='email'
# AUTH_FIREBASE_API_KEY=''
# AUTH_FIREBASE_AUTH_DOMAIN='<project>.firebaseapp.com'
# AUTH_FIREBASE_PROJECT_ID=''
# AUTH_FIREBASE_APP_ID=''
# AUTH_FIREBASE_PROVIDERS='google.com'
# NEXT_PUBLIC_HOSTED_BY='Your organisation'

# The landing page at / (default true). false: / opens the one public organisation, the list, or sign-in.
# LANDING_ENABLED="true"

# --- Optional outside web analytics for the public pages (product rules section 8) ---
# Off unless set here AND configured in Super admin -> Settings, and only after a visitor agrees. Runtime values
# (never NEXT_PUBLIC_); set the same on the backend and the website. Bare https origins, comma-separated.
# WEB_TELEMETRY_ALLOWED_ORIGINS='https://plausible.example.org'
# WEB_TELEMETRY_MIXPANEL_TOKEN=''
# WEB_TELEMETRY_MIXPANEL_API_HOST=''
# WEB_TELEMETRY_MIXPANEL_SDK_HOST=''

# --- Optional background job settings (worker and beat roles) ---
# Prefix for the BullMQ queues in Redis; give installations sharing one Redis different prefixes.
# JOBS_QUEUE_PREFIX='swo:jobs'
# Worker and beat health port (the compose files set 3460) and per-queue worker concurrency (1 to 64).
# JOBS_HEALTH_PORT='3460'
# QUEUE_OUTBOX_CONCURRENCY='5'
# QUEUE_SCHEDULED_CONCURRENCY='2'
