{
  "name": "spaceworks-organization",
  "version": "0.8.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "build:jobs": "node scripts/build-jobs.mjs",
    "worker": "node --env-file-if-exists=.env dist/worker.js",
    "beat": "node --env-file-if-exists=.env dist/beat.js",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "admin": "node docker/ops/admin.mjs",
    "db:seed-demo": "node scripts/seed-demo.mjs",
    "db:seed-reports": "node scripts/seed-reports.mjs",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:coverage": "vitest run --config vitest.coverage.config.mts --coverage",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/prisma.mjs migrate dev",
    "db:deploy": "node --env-file-if-exists=.env scripts/prisma.mjs migrate deploy",
    "db:status": "node --env-file-if-exists=.env scripts/prisma.mjs migrate status",
    "design:sync": "node scripts/sync-design.mjs",
    "test:e2e:production": "node scripts/prepare-standalone.mjs && PLAYWRIGHT_PRODUCTION_SERVER=1 playwright test",
    "frontend:catalog": "node scripts/generate-frontend-catalog.mjs",
    "frontend:prepare": "node scripts/prepare-frontend.mjs",
    "build:frontend": "npm run build --workspace=frontend",
    "typecheck:frontend": "npm run typecheck --workspace=frontend",
    "test:e2e:split": "node scripts/test-split-hosting.mjs",
    "test:e2e:vps": "node scripts/test-split-hosting.mjs --monolith"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@aws-sdk/client-s3": "3.1152.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "bcryptjs": "3.0.3",
    "bullmq": "5.81.5",
    "clsx": "2.1.1",
    "cron-parser": "5.10.2",
    "fontkit": "2.0.4",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.1.7",
    "otpauth": "9.5.2",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-qr-code": "2.2.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/fontkit": "2.0.8",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "mupdf": "1.28.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "workspaces": [
    "frontend"
  ]
}
