generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime queries use DATABASE_URL, which may be a transaction pooler
  // (for example Supabase Supavisor :6543 with ?pgbouncer=true). Migrations need a
  // direct or session-mode connection, so the Prisma CLI uses DIRECT_URL.
  // scripts/prisma.mjs defaults DIRECT_URL to DATABASE_URL when it is unset.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Platform ────────────────────────────────────────────────────────────────

/// Organisation staff roles. OWNER and ADMIN run everything; TREASURER runs money; VIEWER reads.
enum TeamRole {
  OWNER
  ADMIN
  TREASURER
  VIEWER
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  /// User-selected profile image. Provider images remain in `image` as a fallback.
  profileImageUrl    String?
  /// Bcrypt hash for email + password credential logins. Null for OAuth-only users.
  passwordHash       String?
  /// Incremented to invalidate all issued JWT sessions after account recovery.
  sessionVersion     Int       @default(0)
  /// AES-GCM encrypted TOTP seed. Never expose or log this value.
  mfaSecretEncrypted String?
  mfaEnabledAt       DateTime?
  recoveryCodeHashes String[]  @default([])
  /// Platform operators. SUPER_ADMIN_EMAIL bootstraps the first one.
  isSuperAdmin       Boolean   @default(false)
  createdAt          DateTime  @default(now())

  accounts          Account[]
  sessions          Session[]
  knownDevices      KnownDevice[]
  teamMembers       TeamMember[]
  teamInvitesCreated TeamInvite[] @relation("TeamInviteCreatedBy")
  teamInvitesUsed    TeamInvite[] @relation("TeamInviteUsedBy")
  ownershipTransfersFrom OwnershipTransfer[] @relation("OwnershipTransferFrom")
  ownershipTransfersTo   OwnershipTransfer[] @relation("OwnershipTransferTo")
  auditEvents       AuditEvent[]
  organisationReviews OrganisationReview[]
  members           Member[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Tenants ─────────────────────────────────────────────────────────────────

enum OrganisationStatus {
  PENDING_REVIEW
  CHANGES_REQUESTED
  ACTIVE
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum OrganisationSource {
  SELF_SIGNUP
  SUPERADMIN
}

enum OrganisationVisibility {
  UNLISTED
  PUBLIC
}

enum PlanDurationType {
  /// A fixed number of months from the start date.
  ROLLING
  /// Ends on the last day of the organisation's financial year.
  ORG_YEAR
  /// Ends on one fixed date for everyone.
  FIXED_END
  LIFETIME
}

enum RejoinFeeRule {
  NEVER
  ONCE
  EACH_JOIN
  AFTER_LAPSE
}

enum JoinMode {
  OPEN
  APPROVAL
  INVITE_ONLY
  CLOSED
}

enum PaymentTiming {
  PAY_THEN_ACTIVATE
  ACTIVATE_THEN_CHARGE
}

enum PlanFieldType {
  TEXT
  LONG_TEXT
  SELECT
  DATE
  EMAIL
  PHONE
  NUMBER
  CHECKBOX
}

enum MemberSource {
  JOIN_FORM
  MANUAL
  IMPORT
}

enum TermStatus {
  PENDING_APPROVAL
  PENDING_PAYMENT
  UPCOMING
  ACTIVE
  GRACE
  ENDED
  LAPSED
  EXPIRED
  CANCELLED
  REJECTED
  REVOKED
}

enum TermKind {
  NEW
  RENEWAL
  REINSTATEMENT
}

enum OrganisationReviewAction {
  SUBMITTED
  RESUBMITTED
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  SUSPENDED
  REACTIVATED
  ARCHIVED
  CREATED
}

/// A tenant. Only ACTIVE organisations can run memberships; see organisationAllows in lib/permissions.ts.
model Organisation {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  description String             @default("")
  logoUrl     String?
  /// Organisation accent for its public pages (validated #RRGGBB).
  accentColor String?
  status      OrganisationStatus @default(PENDING_REVIEW)
  source      OrganisationSource @default(SELF_SIGNUP)
  /// Free-text kind, e.g. "Club", "Association", "Student society".
  kind        String             @default("")
  contactEmail String?
  /// Members can sign in to their own portal (memberships, payments, profile). Off: the organisation just keeps
  /// records; "Pay now" emails carry a secure pay link instead, and /verify still checks cards.
  memberPortal Boolean            @default(true)
  contactPhone String?
  addressLine String?
  city        String?
  /// Indian state/UT code (two letters, e.g. "KL"); also the GST supplier state.
  stateCode   String?
  postalCode  String?
  country     String             @default("IN")
  website     String?
  /// Month (1–12) the organisation's financial and membership year starts. India: April.
  financialYearStartMonth Int    @default(4)
  timezone    String             @default("Asia/Kolkata")
  currency    String             @default("INR")
  /// Set by the platform super-admin; null means the instance default.
  memberLimit  Int?
  managerLimit Int?
  /// Maker-checker for offline payments: the confirmer must differ from the recorder.
  offlineConfirmationRequired Boolean @default(false)
  /// Members may upload their own photo for their card from their account.
  memberPhotoUpload Boolean @default(false)
  /// PUBLIC organisations are listed at /organisations and take applications from anyone.
  visibility  OrganisationVisibility @default(UNLISTED)
  /// Names of the unit levels the organisation uses, top first, e.g. ["Region", "District", "Chapter"].
  unitLevels  String[]           @default([])
  /// Number formatting override, e.g. "en-IN"; null uses the currency's own locale.
  locale      String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  teamMembers   TeamMember[]
  teamInvites   TeamInvite[]
  staffRoles    OrgRole[]
  emailTemplates OrgEmailTemplate[]
  ownershipTransfers OwnershipTransfer[]
  reviews       OrganisationReview[]
  assets        Asset[]
  auditEvents   AuditEvent[]
  units         OrgUnit[]
  memberRoles   MemberRole[]
  plans         MembershipPlan[]
  members       Member[]
  terms         MembershipTerm[]
  counters      OrgCounter[]
  paymentSettings OrgPaymentSettings?
  taxSettings     OrgTaxSettings?
  payments        Payment[]
  refunds         Refund[]
  taxDocuments    TaxDocument[]
  documentCounters DocumentCounter[]
  cardDesigns   CardDesign[]
  memberCards   MemberCard[]
  cardExports   CardExportJob[]
  page          OrganisationPage?
  erasureRequests ErasureRequest[]
  dailyStats    OrgDailyStats[]
  ledgerEntries LedgerEntry[]
  openingBalances OpeningBalance[]
  refundRequests RefundRequest[]
  emailSettings  OrgEmailSettings?
  chatChannels   ChatChannel[]
  statsDirtyDays OrgStatsDirtyDay[]

  @@index([status, createdAt])
  @@index([visibility, status])
}

/// Append-only history of an organisation's application and lifecycle decisions.
model OrganisationReview {
  id             String                   @id @default(cuid())
  organisationId String
  action         OrganisationReviewAction
  actorUserId    String?
  /// Required for REJECTED and CHANGES_REQUESTED; shown to the applicant.
  reason         String?
  /// The application as submitted (name, contact, address, purpose…) at SUBMITTED/RESUBMITTED.
  applicationSnapshot Json?
  createdAt      DateTime                 @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([action, createdAt])
}

model TeamInvite {
  id              String   @id @default(cuid())
  organisationId  String
  token           String   @unique
  /// The nearest fixed role, still written so an update rollback works; `roleId` is what counts.
  role            TeamRole @default(VIEWER)
  roleId          String
  /// Set to give the role for one unit's subtree instead of the whole organisation.
  unitId          String?
  createdByUserId String?
  /// Set when the platform super-admin creates an organisation for someone: only this email may accept.
  email           String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime?
  usedAt          DateTime?
  usedByUserId    String?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  orgRole      OrgRole      @relation(fields: [organisationId, roleId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  unit         OrgUnit?     @relation(fields: [organisationId, unitId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User?        @relation("TeamInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  usedBy       User?        @relation("TeamInviteUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([organisationId])
  @@index([organisationId, roleId])
  @@index([organisationId, createdAt])
  @@index([usedAt])
}

/// A person on an organisation's team (managers and staff). Members of the organisation are `Member`.
model TeamMember {
  id             String   @id @default(cuid())
  userId         String
  organisationId String
  /// The nearest fixed role, still written so an update rollback works; `roleId` is what counts.
  role           TeamRole
  roleId         String
  /// Set to limit this person to one unit's subtree (members, payments and reports there only).
  unitId         String?
  /// Email this person a monthly summary of the organisation (their own unit when scoped).
  reportDigest   Boolean  @default(true)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  orgRole      OrgRole      @relation(fields: [organisationId, roleId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  unit         OrgUnit?     @relation(fields: [organisationId, unitId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([userId, organisationId])
  @@index([organisationId])
  @@index([organisationId, roleId])
}

/// A staff role an organisation defines: a name and permissions from the fixed list in lib/permissionRoles.ts. Where
/// someone holds it (the whole organisation or one unit's subtree) belongs to the grant: TeamMember.unitId.
model OrgRole {
  id             String    @id @default(cuid())
  organisationId String
  name           String
  description    String    @default("")
  capabilities   String[]  @default([])
  /// The organisation's one Owner role: every permission, never edited, archived or given by invite.
  isOwner        Boolean   @default(false)
  /// For the four starter roles, the fixed role each replaced. Lets a rolled-back release still give roles.
  starterKey     TeamRole?
  sortOrder      Int       @default(0)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  teamMembers  TeamMember[]
  invites      TeamInvite[]
  ownershipTransfers OwnershipTransfer[]

  @@unique([organisationId, id])
  @@unique([organisationId, name])
}

/// The owner offering the organisation to another staff member who holds their role for the whole organisation; it
/// moves when that person accepts. At most one open transfer per organisation (partial unique index, migration 0016).
model OwnershipTransfer {
  id             String    @id @default(cuid())
  organisationId String
  fromUserId     String
  toUserId       String
  /// The role the current owner keeps once the transfer is accepted.
  keepRoleId     String
  /// 32 random bytes, base64url: what the proposed owner accepts with.
  token          String    @unique
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?
  cancelledAt    DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  fromUser     User         @relation("OwnershipTransferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser       User         @relation("OwnershipTransferTo", fields: [toUserId], references: [id], onDelete: Cascade)
  keepRole     OrgRole      @relation(fields: [organisationId, keepRoleId], references: [organisationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organisationId, createdAt])
  @@index([toUserId])
}

// ─── Operations ──────────────────────────────────────────────────────────────

model AuditEvent {
  id               String   @id @default(cuid())
  action           String
  actorUserId      String?
  organisationId   String?
  targetType       String?
  targetId         String?
  metadata         Json?
  createdAt        DateTime @default(now())

  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model OutboxMessage {
  id          String       @id @default(cuid())
  kind        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  lockedAt    DateTime?
  sentAt      DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())

  @@index([status, availableAt])
  @@index([createdAt])
}

/// One-row operational state for scheduled work, separate from the human audit trail.
model OperationalHeartbeat {
  key             String    @id
  lastStartedAt   DateTime?
  lastSucceededAt DateTime?
  lastSent        Int       @default(0)
  lastFailed      Int       @default(0)
  lastError       String?
  updatedAt       DateTime  @updatedAt
}

/// Instance-wide, super-admin-managed controls. The singleton row is created on first change.
model InstanceSetting {
  id                    String   @id
  allowNewUserSignups   Boolean  @default(true)
  /// Self-service organisation applications (/start). Super-admins can always create organisations.
  allowOrganisationApplications Boolean @default(true)
  emailFrom             String?
  smtpService           String?
  smtpHost              String?
  smtpPort              Int?
  smtpSecure            Boolean  @default(false)
  smtpUser              String?
  smtpPasswordEncrypted String?
  smtpAllowUnauthenticated Boolean @default(false)
  googleClientId        String?
  googleClientSecretEncrypted String?
  githubClientId        String?
  githubClientSecretEncrypted String?
  /// Apple "Services ID", team id and key id; the .p8 private key is encrypted at rest.
  appleClientId         String?
  appleTeamId           String?
  appleKeyId            String?
  applePrivateKeyEncrypted String?
  backupProvider        String?
  backupLastSuccessAt   DateTime?
  backupRetentionDays   Int?
  updatedAt             DateTime @updatedAt
}

/// Stored files (Silo/S3/R2) for per-organisation storage accounting, or the database fallback.
model Asset {
  id             String   @id @default(cuid())
  organisationId String?
  /// Provider-specific object key (or path).
  key            String   @unique
  publicUrl      String?
  contentType    String?
  byteSize       BigInt?
  provider       String   @default("unknown")
  fileData       Bytes?
  createdAt      DateTime @default(now())

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([createdAt])
  @@index([provider])
}

/// A part of an organisation: a region, district, chapter or branch. `path` is the ancestor chain of ids
/// ("rootId/childId/thisId"), so a subtree is one prefix query. Archived, never deleted, once used.
model OrgUnit {
  id             String    @id @default(cuid())
  organisationId String
  parentId       String?
  name           String
  slug           String
  /// Short code (1 to 6 of A-Z and 0-9), unique per organisation: card numbers and join links use it.
  code           String
  /// How members of this unit pay offline (whom to pay, when, the UPI id). Empty: the nearest unit above's, then the
  /// organisation's offline instructions.
  paymentInstructions String @default("")
  /// 0 for top-level units; indexes Organisation.unitLevels.
  level          Int       @default(0)
  path           String
  sortOrder      Int       @default(0)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  parent       OrgUnit?     @relation("UnitTree", fields: [organisationId, parentId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  children     OrgUnit[]    @relation("UnitTree")
  members      Member[]
  roles        MemberRole[]
  planUnits    PlanUnit[]
  teamMembers  TeamMember[]
  teamInvites  TeamInvite[]
  dailyStats   OrgDailyStats[]

  @@unique([organisationId, id])
  @@unique([organisationId, slug])
  @@unique([organisationId, code])
  @@index([organisationId, path])
}

/// A role an organisation gives its members ("Secretary", "Systems Engineer"). Printed on member cards.
/// Distinct from team access roles (TeamRole).
model MemberRole {
  id             String    @id @default(cuid())
  organisationId String
  name           String
  description    String    @default("")
  /// One of the brand chip tones: teal, citron, sky, yellow, orange, ink.
  color          String    @default("teal")
  sortOrder      Int       @default(0)
  /// Optional: only offered for members of this unit's subtree.
  unitId         String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  unit         OrgUnit?     @relation(fields: [organisationId, unitId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  assignments  MemberRoleAssignment[]
  cardDesigns  CardDesign[]

  @@unique([organisationId, id])
  @@unique([organisationId, name])
}

model MembershipPlan {
  id                  String           @id @default(cuid())
  organisationId      String
  name                String
  slug                String
  description         String           @default("")
  /// ISO 4217; every price below is in this currency's minor units.
  currency            String           @default("INR")
  durationType        PlanDurationType @default(ORG_YEAR)
  durationMonths      Int?
  fixedEndDate        DateTime?
  priceNewMinor       Int              @default(0)
  priceRenewalMinor   Int              @default(0)
  joiningFeeMinor     Int              @default(0)
  rejoinFeeRule       RejoinFeeRule    @default(NEVER)
  rejoinAfterDays     Int?
  graceDays           Int              @default(15)
  renewalWindowDays   Int              @default(30)
  reminderDaysBefore  Int[]            @default([30, 7, 0])
  reminderDaysAfter   Int[]            @default([7])
  /// A late renewal starts at the old end date (true) or on the day it is paid (false).
  lateRenewalBackdate Boolean          @default(true)
  joinMode            JoinMode         @default(APPROVAL)
  paymentTiming       PaymentTiming    @default(PAY_THEN_ACTIVATE)
  /// When false, only members of the units in PlanUnit may join.
  allUnits            Boolean          @default(true)
  sortOrder           Int              @default(0)
  archivedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  fields       PlanField[]
  units        PlanUnit[]
  terms        MembershipTerm[]
  invites      MemberInvite[]
  cardDesigns  CardDesign[]
  cards        MemberCard[]
  dailyStats   OrgDailyStats[]

  @@unique([organisationId, id])
  @@unique([organisationId, slug])
}

model PlanUnit {
  organisationId String
  planId         String
  unitId         String

  plan MembershipPlan @relation(fields: [organisationId, planId], references: [organisationId, id], onDelete: Cascade)
  unit OrgUnit        @relation(fields: [organisationId, unitId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([planId, unitId])
}

/// A question on a plan's join form. Answers live in Member.fieldValues under `key`.
model PlanField {
  id             String        @id @default(cuid())
  organisationId String
  planId         String
  key            String
  label          String
  helpText       String        @default("")
  type           PlanFieldType @default(TEXT)
  required       Boolean       @default(false)
  options        String[]      @default([])
  /// Only managers see and fill it; never on the public form.
  adminOnly      Boolean       @default(false)
  sortOrder      Int           @default(0)

  plan MembershipPlan @relation(fields: [organisationId, planId], references: [organisationId, id], onDelete: Cascade)

  @@unique([planId, key])
}

/// One person in one organisation. Their membership periods are MembershipTerm rows.
model Member {
  id             String       @id @default(cuid())
  organisationId String
  /// The account that owns this record, once the person signs in with the same verified email.
  userId         String?
  email          String
  name           String
  phone          String?
  photoUrl       String?
  /// Indian state/UT code; place of supply on tax documents.
  stateCode      String?
  gstin          String?
  unitId         String?
  /// Per-organisation running number, from OrgCounter "member".
  memberNumber   Int
  fieldValues    Json         @default("{}")
  source         MemberSource @default(JOIN_FORM)
  isMinor        Boolean      @default(false)
  guardianName   String?
  guardianEmail  String?
  guardianPhone  String?
  notes          String       @default("")
  anonymisedAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  unit         OrgUnit?               @relation(fields: [organisationId, unitId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  terms        MembershipTerm[]
  roles        MemberRoleAssignment[]
  consents     ConsentRecord[]
  payments     Payment[]
  refundRequests RefundRequest[]
  cards        MemberCard[]
  erasureRequests ErasureRequest[]

  @@unique([organisationId, id])
  @@unique([organisationId, email])
  @@unique([organisationId, memberNumber])
  @@index([userId])
  @@index([organisationId, unitId])
  @@index([organisationId, createdAt])
}

model MemberRoleAssignment {
  organisationId String
  memberId       String
  roleId         String
  /// The role printed on the member card. At most one per member.
  isPrimary      Boolean  @default(false)
  assignedAt     DateTime @default(now())

  member Member     @relation(fields: [organisationId, memberId], references: [organisationId, id], onDelete: Cascade)
  role   MemberRole @relation(fields: [organisationId, roleId], references: [organisationId, id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@index([organisationId, roleId])
}

/// One membership period of one member on one plan. The status is a cache kept aligned by the sweep;
/// lib/membership/lifecycle.ts deriveStatus is the source of truth for display.
model MembershipTerm {
  id              String     @id @default(cuid())
  organisationId  String
  memberId        String
  planId          String
  status          TermStatus
  kind            TermKind   @default(NEW)
  startsAt        DateTime?
  endsAt          DateTime?
  graceUntil      DateTime?
  paymentDueBy    DateTime?
  /// Price frozen when the term was created, in the plan's currency at that time.
  currency        String
  priceMinor      Int
  joiningFeeMinor Int        @default(0)
  renewedFromId   String?
  decidedById     String?
  decidedAt       DateTime?
  reason          String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  member       Member            @relation(fields: [organisationId, memberId], references: [organisationId, id], onDelete: Cascade)
  plan         MembershipPlan    @relation(fields: [organisationId, planId], references: [organisationId, id], onDelete: Restrict)
  renewedFrom  MembershipTerm?   @relation("Renewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewals     MembershipTerm[]  @relation("Renewal")
  events       TermStatusEvent[]
  reminders    ReminderLog[]
  payments     Payment[]
  refundRequests RefundRequest[]

  @@unique([organisationId, id])
  @@index([organisationId, status, endsAt])
  @@index([organisationId, createdAt])
  @@index([memberId, planId])
}

model TermStatusEvent {
  id             String      @id @default(cuid())
  organisationId String
  termId         String
  from           TermStatus?
  to             TermStatus
  /// Domain time of the change, e.g. the term's end date for an expiry the sweep records later.
  effectiveAt    DateTime
  recordedAt     DateTime    @default(now())
  actorUserId    String?
  cause          String

  term MembershipTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@index([termId, recordedAt])
  @@index([organisationId, effectiveAt])
}

/// A reminder sent for a term. The unique key makes each reminder go out once, however often the sweep runs.
model ReminderLog {
  termId String
  key    String
  sentAt DateTime @default(now())

  term MembershipTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([termId, key])
}

model ConsentRecord {
  id             String    @id @default(cuid())
  organisationId String
  memberId       String
  purpose        String
  noticeVersion  String
  grantedAt      DateTime  @default(now())
  withdrawnAt    DateTime?
  byGuardian     Boolean   @default(false)

  member Member @relation(fields: [organisationId, memberId], references: [organisationId, id], onDelete: Cascade)

  @@index([memberId])
}

/// Gapless per-organisation counters ("member" numbers now; receipt series join in P7).
model OrgCounter {
  organisationId String
  name           String
  next           Int    @default(1)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([organisationId, name])
}

/// An invitation to join an INVITE_ONLY plan (any plan, in fact). Optionally bound to one email address.
model MemberInvite {
  id             String    @id @default(cuid())
  organisationId String
  planId         String
  token          String    @unique
  /// When set, only this verified email can use the invite.
  email          String?
  /// Optional preselected unit for whoever joins with it.
  unitId         String?
  /// Uses allowed; 1 for a personal invite, more for a shared link.
  maxUses        Int       @default(1)
  uses           Int       @default(0)
  createdById    String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?

  plan MembershipPlan @relation(fields: [organisationId, planId], references: [organisationId, id], onDelete: Cascade)

  @@index([organisationId, planId])
}

// ── Payments and tax documents (P7) ─────────────────────────────────────────

enum GatewayProvider {
  NONE
  RAZORPAY
  STRIPE
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  OFFLINE
}

enum PaymentStatus {
  PENDING
  AWAITING_CONFIRMATION
  PAID
  WAIVED
  FAILED
  CANCELLED
}

enum PaymentLineKind {
  TERM_FEE
  JOINING_FEE
  REJOIN_FEE
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum RefundPolicy {
  NONE
  FULL
  PRO_RATA
}

enum RefundRequestStatus {
  OPEN
  APPROVED
  DECLINED
  WITHDRAWN
}

enum TaxMode {
  GST
  SIMPLE
  NONE
}

enum GstScheme {
  REGULAR
  COMPOSITION
}

/// How a GST-registered organisation treats plans priced in other currencies.
enum ForeignCurrencyTax {
  EXPORT_LUT
  NO_TAX
}

enum TaxDocumentKind {
  RECEIPT
  TAX_INVOICE
  BILL_OF_SUPPLY
  CREDIT_NOTE
}

/// The organisation's payment gateway. Secrets are AES-GCM encrypted with PAYMENT_SECRETS_KEY.
model OrgPaymentSettings {
  organisationId         String          @id
  provider               GatewayProvider @default(NONE)
  /// Razorpay key id (public). Stripe needs only the secret key.
  keyId                  String?
  secretEncrypted        String?
  webhookSecretEncrypted String?
  /// Unguessable code in the webhook URL that identifies the organisation.
  webhookPublicCode      String          @unique
  testMode               Boolean         @default(true)
  verifiedAt             DateTime?
  upiVpa                 String?
  upiPayeeName           String?
  offlineInstructions    String          @default("")
  /// What members may get back when they cancel: nothing, everything, or the unused share of the fee.
  refundPolicy           RefundPolicy    @default(NONE)
  refundWindowDays       Int             @default(14)
  refundPolicyText       String          @default("")
  updatedAt              DateTime        @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

model OrgTaxSettings {
  organisationId     String             @id
  mode               TaxMode            @default(NONE)
  scheme             GstScheme          @default(REGULAR)
  gstin              String?
  legalName          String?
  address            String?
  /// Supplier state code; also the place-of-supply fallback.
  stateCode          String?
  sacCode            String             @default("999599")
  rateBps            Int                @default(1800)
  inclusive          Boolean            @default(true)
  exempt             Boolean            @default(false)
  foreignCurrencyTax ForeignCurrencyTax @default(NO_TAX)
  lutNumber          String?
  /// Name printed for SIMPLE mode, e.g. "VAT".
  simpleTaxName      String             @default("Tax")
  /// 0–4 uppercase letters or digits before every document number.
  receiptPrefix      String             @default("")
  updatedAt          DateTime           @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

model Payment {
  id               String          @id @default(cuid())
  organisationId   String
  memberId         String
  termId           String?
  status           PaymentStatus   @default(PENDING)
  provider         PaymentProvider
  /// upi, card, netbanking, wallet, cash, bank_transfer, cheque…
  method           String?
  currency         String
  amountMinor      Int
  /// Razorpay order id or Stripe Checkout Session id.
  gatewayOrderId   String?
  /// Razorpay payment id or Stripe PaymentIntent id.
  gatewayPaymentId String?
  settlementId     String?
  utr              String?
  reference        String?
  note             String          @default("")
  paidAt           DateTime?
  recordedById     String?
  confirmedById    String?
  /// The member said "I've paid" (a UTR claim), rather than staff recording money they took.
  memberClaim      Boolean         @default(false)
  /// Set when a captured payment needs a manager's attention (late, mismatched, duplicate).
  flaggedAt        DateTime?
  flagReason       String?
  /// The tax document waits for review (amount mismatch).
  documentHeld     Boolean         @default(false)
  capturedMinor    Int?
  /// Tax configuration frozen when the payment was created.
  taxSnapshot      Json
  anonymisedAt     DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  member       Member          @relation(fields: [organisationId, memberId], references: [organisationId, id], onDelete: Restrict)
  term         MembershipTerm? @relation(fields: [organisationId, termId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  lines        PaymentLine[]
  refunds      Refund[]
  documents    TaxDocument[]
  refundRequests RefundRequest[]

  @@unique([organisationId, id])
  @@unique([provider, gatewayOrderId])
  @@index([organisationId, status, createdAt])
  @@index([organisationId, paidAt])
  @@index([organisationId, memberId])
  @@index([termId])
}

model PaymentLine {
  id             String          @id @default(cuid())
  organisationId String
  paymentId      String
  kind           PaymentLineKind
  description    String
  currency       String
  amountMinor    Int
  taxableMinor   Int
  cgstMinor      Int             @default(0)
  sgstMinor      Int             @default(0)
  igstMinor      Int             @default(0)
  otherTaxMinor  Int             @default(0)

  payment Payment @relation(fields: [organisationId, paymentId], references: [organisationId, id], onDelete: Restrict)

  @@index([paymentId])
}

/// Webhook idempotency: a provider event is applied once.
model ProcessedWebhookEvent {
  provider       PaymentProvider
  eventId        String
  organisationId String
  receivedAt     DateTime        @default(now())

  @@id([provider, eventId])
  @@index([organisationId, receivedAt])
}

model Refund {
  id              String       @id @default(cuid())
  organisationId  String
  paymentId       String
  status          RefundStatus @default(PENDING)
  currency        String
  amountMinor     Int
  reason          String       @default("")
  gatewayRefundId String?      @unique
  createdById     String?
  failureReason   String?
  createdAt       DateTime     @default(now())
  processedAt     DateTime?
  /// When the scheduler last asked the gateway about this pending refund.
  lastCheckedAt   DateTime?
  request         RefundRequest?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  payment      Payment      @relation(fields: [organisationId, paymentId], references: [organisationId, id], onDelete: Restrict)
  document     TaxDocument?

  @@unique([organisationId, id])
  @@index([organisationId, createdAt])
  @@index([paymentId])
}

/// Receipts, tax invoices, bills of supply and credit notes. The PDF is rendered from `snapshot`.
model TaxDocument {
  id              String          @id @default(cuid())
  organisationId  String
  paymentId       String?
  refundId        String?         @unique
  kind            TaxDocumentKind
  /// "R" for payment documents, "C" for credit notes.
  series          String
  /// "2026-27" in the organisation's financial year.
  financialYear   String
  sequence        Int
  number          String
  currency        String
  totalMinor      Int
  taxableMinor    Int
  cgstMinor       Int             @default(0)
  sgstMinor       Int             @default(0)
  igstMinor       Int             @default(0)
  otherTaxMinor   Int             @default(0)
  placeOfSupply   String?
  sac             String?
  snapshot        Json
  templateVersion Int             @default(1)
  issuedAt        DateTime        @default(now())
  cancelledAt     DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  payment      Payment?     @relation(fields: [organisationId, paymentId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  refund       Refund?      @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@unique([organisationId, number])
  @@unique([organisationId, series, financialYear, sequence])
  @@index([organisationId, issuedAt])
  @@index([paymentId])
}

/// Gapless document numbering per organisation, series and financial year.
model DocumentCounter {
  organisationId String
  series         String
  financialYear  String
  next           Int    @default(1)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([organisationId, series, financialYear])
}

// ─── Member cards ────────────────────────────────────────────────────────────

/// A member card design: the organisation default (planId and roleId null), one plan's own, or one member
/// role's own. A card uses its member's primary role design, else its plan's, else the organisation's.
/// Managers edit `draft`; only the owner approves it, which copies it into the live columns (`design`,
/// numbering, watermark) that every member's card is drawn from (lib/cards/approval.ts).
model CardDesign {
  id             String   @id @default(cuid())
  organisationId String
  planId         String?
  roleId         String?
  /// The approved front and back (lib/cards/design/presets.ts normalises it on every read); null until
  /// the first approval, and the row is ignored until then.
  design         Json?
  /// Changes waiting for the owner's approval: { design, numberPrefix, numberFormat, watermarkUrl }.
  draft          Json?
  draftUpdatedById String?
  draftUpdatedAt   DateTime?
  approvedById   String?
  approvedAt     DateTime?
  /// Prefix of printed card numbers, e.g. "SWO" in SWO-0042. Read from the organisation default and
  /// role designs only (lib/cards/numbering.ts).
  numberPrefix   String
  /// Card number pattern, e.g. "{PREFIX}-{SEQ:4}". Read from the organisation default and role designs.
  numberFormat   String   @default("{PREFIX}-{SEQ:4}")
  /// Watermark image (a managed upload) for designs that use one.
  watermarkUrl   String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  plan         MembershipPlan? @relation(fields: [organisationId, planId], references: [organisationId, id], onDelete: Cascade)
  role         MemberRole?     @relation(fields: [organisationId, roleId], references: [organisationId, id], onDelete: Cascade)

  @@unique([organisationId, id])
  @@unique([organisationId, planId])
  @@unique([organisationId, roleId])
}

/// A member's card for one plan. The verify token sits in the QR and is unguessable; renewals keep the
/// card and its QR, because /verify reads the membership live. Reissuing revokes the old card and issues
/// a new token, so an old QR stops verifying.
model MemberCard {
  id             String    @id @default(cuid())
  organisationId String
  memberId       String
  planId         String
  cardNumber     String
  /// 32 random bytes, base64url. Treat as a bearer value: never log it.
  verifyToken    String    @unique
  issuedAt       DateTime  @default(now())
  issuedById     String?
  revokedAt      DateTime?
  revokedById    String?
  /// REISSUED (replaced by a newer card), REVOKED (by a manager) or MEMBERSHIP_ENDED.
  revokedReason  String?
  lastEmailedAt  DateTime?

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  member       Member         @relation(fields: [organisationId, memberId], references: [organisationId, id], onDelete: Cascade)
  plan         MembershipPlan @relation(fields: [organisationId, planId], references: [organisationId, id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([memberId, planId])
  @@index([organisationId, issuedAt])
  @@index([organisationId, cardNumber])
}

enum CardExportStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// A bulk card export (one PDF, or a ZIP of PDFs) built in the background and stored privately.
model CardExportJob {
  id             String           @id @default(cuid())
  organisationId String
  requestedById  String?
  /// "sheet" (A4 sheets with crop marks), "cards" (one card per page) or "zip" (one PDF per member).
  format         String
  /// The member filter chosen on the members page, plus the requester's unit scope.
  filter         Json
  status         CardExportStatus @default(PENDING)
  attempts       Int              @default(0)
  cardCount      Int?
  storageKey     String?
  byteSize       Int?
  error          String?
  lockedAt       DateTime?
  createdAt      DateTime         @default(now())
  finishedAt     DateTime?
  /// The file is deleted after this; the row stays as a record of the export.
  expiresAt      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([organisationId, createdAt])
}

// ─── Member portal and public page (P8) ─────────────────────────────────────

/**
 * The organisation's public page at /o/[slug]. The columns hold what is published; `draft` holds unpublished
 * edits in the same shape (lib/publicPage/sections.ts). With no publishedAt the plain page shows.
 */
model OrganisationPage {
  organisationId String    @id
  tagline        String    @default("")
  /// Storage key of the cover image (organisations/<id>/page-images/<uuid>.webp).
  coverAssetKey  String?
  /// Validated #RRGGBB; null uses the organisation's accent.
  accentColor    String?
  sections       Json      @default("[]")
  publishedAt    DateTime?
  draft          Json?
  updatedById    String?
  updatedAt      DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

enum ErasureStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/**
 * A member asking an organisation to erase their details. A manager approves (the member is anonymised;
 * money rows stay) or rejects with a note.
 */
model ErasureRequest {
  id                String        @id @default(cuid())
  organisationId    String
  memberId          String
  /// The account that asked; its email gets the decision.
  requestedByUserId String?
  status            ErasureStatus @default(PENDING)
  reason            String        @default("")
  decidedById       String?
  decidedAt         DateTime?
  decisionNote      String?
  createdAt         DateTime      @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [organisationId, memberId], references: [organisationId, id], onDelete: Cascade)

  @@unique([organisationId, id])
  @@index([organisationId, status, createdAt])
  @@index([memberId])
}

// ─── Reports ─────────────────────────────────────────────────────────────────

/// Daily membership numbers per organisation, unit and plan, written by the sweep (lib/reports/rollup.ts)
/// and defined in docs/REPORTS.md. `day` is the organisation's local calendar day. `planId` null is the
/// all-plans row (distinct members); `unitId` null is members without a unit. Every day is recomputable
/// from source rows: the rollup deletes and rewrites a whole (organisation, day).
model OrgDailyStats {
  id             String   @id @default(cuid())
  organisationId String
  day            DateTime @db.Date
  unitId         String?
  planId         String?
  /// Stocks at the end of the day.
  active         Int      @default(0)
  grace          Int      @default(0)
  /// Members whose last membership ended (lapsed or expired) and who hold no live one.
  expired        Int      @default(0)
  /// Flows during the day.
  joined         Int      @default(0)
  reactivated    Int      @default(0)
  due            Int      @default(0)
  renewed        Int      @default(0)
  lapsed         Int      @default(0)
  applications   Int      @default(0)
  computedAt     DateTime @default(now())

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  unit         OrgUnit?        @relation(fields: [organisationId, unitId], references: [organisationId, id], onDelete: Cascade, onUpdate: Restrict)
  plan         MembershipPlan? @relation(fields: [organisationId, planId], references: [organisationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organisationId, day])
  @@index([day])
}

/// Days whose rollup must be rebuilt (a backdated change touched them). The next sweep rebuilds and clears them.
model OrgStatsDirtyDay {
  organisationId String
  day            DateTime @db.Date
  markedAt       DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([organisationId, day])
}

// ── Accounts: the organisation's own receipts and payments (owner, 2026-10-20) ──

enum LedgerDirection {
  RECEIPT
  PAYMENT
}

/// Money in or out that isn't a member's payment: donations, grants, rent, equipment, GST paid and so on.
/// Membership fees and refunds come from the payments tables. Entries are never deleted; a mistake is voided.
model LedgerEntry {
  id             String          @id @default(cuid())
  organisationId String
  direction      LedgerDirection
  /// The day the money moved, as a calendar date in the organisation's timezone (stored at UTC midnight).
  occurredOn     DateTime        @db.Date
  category       String
  /// Who paid it (receipts) or who was paid (payments).
  party          String          @default("")
  description    String          @default("")
  currency       String
  amountMinor    Int
  /// cash, bank_transfer, upi, cheque, card or other: cash moves the cash balance, everything else the bank.
  method         String
  reference      String?
  recordedById   String?
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  createdAt      DateTime        @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, occurredOn])
}

/// Cash in hand and at the bank at the start of a financial year, per currency, as the accounts carried forward.
model OpeningBalance {
  organisationId String
  financialYear  String
  currency       String
  cashMinor      Int      @default(0)
  bankMinor      Int      @default(0)
  updatedById    String?
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([organisationId, financialYear, currency])
}

/// A member asking for their money back, which also asks to end the membership. A manager approves (refund
/// plus cancellation) or declines; the member may withdraw while it is open. One open request per payment.
model RefundRequest {
  id                String              @id @default(cuid())
  organisationId    String
  paymentId         String
  termId            String
  memberId          String
  requestedByUserId String?
  reason            String
  status            RefundRequestStatus @default(OPEN)
  /// What the policy offered when the member asked; the manager may approve another amount.
  suggestedMinor    Int
  currency          String
  decidedById       String?
  decidedAt         DateTime?
  decisionNote      String?
  refundId          String?             @unique
  createdAt         DateTime            @default(now())

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  payment      Payment        @relation(fields: [organisationId, paymentId], references: [organisationId, id], onDelete: Restrict)
  term         MembershipTerm @relation(fields: [organisationId, termId], references: [organisationId, id], onDelete: Restrict)
  member       Member         @relation(fields: [organisationId, memberId], references: [organisationId, id], onDelete: Restrict)
  refund       Refund?        @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, status, createdAt])
  @@index([paymentId])
}

/// An organisation's own outgoing email for member emails. Without it (or while disabled) member emails go
/// through the platform's SMTP, sent as the organisation's name with replies to its contact email. Account
/// emails (password reset, verification) always use the platform's.
model OrgEmailSettings {
  organisationId        String    @id
  enabled               Boolean   @default(false)
  fromName              String    @default("")
  fromAddress           String?
  replyTo               String?
  smtpHost              String?
  smtpPort              Int       @default(587)
  /// Implicit TLS (port 465); otherwise STARTTLS is required in production.
  smtpSecure            Boolean   @default(false)
  smtpUser              String?
  smtpPasswordEncrypted String?
  verifiedAt            DateTime?
  updatedAt             DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

enum ChatChannelKind {
  SLACK
  DISCORD
  MATTERMOST
  TELEGRAM
  WHATSAPP
}

/// A chat destination for team alerts. Webhook URLs, bot tokens and WhatsApp credentials live encrypted in
/// `configEncrypted`; `target` is a safe, non-secret description for the settings page.
model ChatChannel {
  id              String          @id @default(cuid())
  organisationId  String
  kind            ChatChannelKind
  name            String
  configEncrypted String
  target          String          @default("")
  events          String[]
  includeNames    Boolean         @default(false)
  enabled         Boolean         @default(true)
  lastDeliveredAt DateTime?
  lastError       String?
  failures        Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, id])
  @@index([organisationId])
}

/// A browser that has signed in to an account before, recognised by a long-lived cookie stored only as a hash.
/// A sign-in from anywhere else needs an emailed code (accounts without an authenticator) and sends an alert.
model KnownDevice {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  label       String   @default("")
  lastIp      String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
}

/// An organisation's own wording for one member-facing email (`kind`, e.g. "card-issued", "membership-activated").
/// Plain text with {placeholders}, rendered as escaped paragraphs; without a row the platform's wording is used.
model OrgEmailTemplate {
  organisationId String
  kind           String
  subject        String
  heading        String
  body           String
  updatedById    String?
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([organisationId, kind])
}
