generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Runtime queries use DATABASE_URL, which may be a transaction pooler
  // (for example Supabase Supavisor :6543 with ?pgbouncer=true). Migrations need a
  // direct or session-mode connection, so the Prisma CLI uses DIRECT_URL.
  // scripts/prisma.mjs defaults DIRECT_URL to DATABASE_URL when it is unset.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Platform ────────────────────────────────────────────────────────────────

/// Organisation staff roles. OWNER and ADMIN run everything; TREASURER runs money; VIEWER reads.
enum TeamRole {
  OWNER
  ADMIN
  TREASURER
  VIEWER
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  /// User-selected profile image. Provider images remain in `image` as a fallback.
  profileImageUrl    String?
  /// Bcrypt hash for email + password credential logins. Null for OAuth-only users.
  passwordHash       String?
  /// Incremented to invalidate all issued JWT sessions after account recovery.
  sessionVersion     Int       @default(0)
  /// AES-GCM encrypted TOTP seed. Never expose or log this value.
  mfaSecretEncrypted String?
  mfaEnabledAt       DateTime?
  recoveryCodeHashes String[]  @default([])
  /// Platform operators. SUPER_ADMIN_EMAIL bootstraps the first one.
  isSuperAdmin       Boolean   @default(false)
  createdAt          DateTime  @default(now())
  /// A verified phone number (E.164) for phone-code sign-in. Set only once verified; unique across accounts.
  phoneE164          String?   @unique
  phoneVerifiedAt    DateTime?

  accounts          Account[]
  sessions          Session[]
  knownDevices      KnownDevice[]
  passkeys          Passkey[]
  userSessions      UserSession[]
  teamMembers       TeamMember[]
  teamInvitesCreated TeamInvite[] @relation("TeamInviteCreatedBy")
  teamInvitesUsed    TeamInvite[] @relation("TeamInviteUsedBy")
  smartGroups        SmartGroup[]
  ownershipTransfersFrom OwnershipTransfer[] @relation("OwnershipTransferFrom")
  ownershipTransfersTo   OwnershipTransfer[] @relation("OwnershipTransferTo")
  auditEvents       AuditEvent[]
  organisationReviews OrganisationReview[]
  members           Member[]
  notificationEndpoints NotificationEndpoint[]
  endpointChallenges NotificationEndpointChallenge[]
  messagingConsents MessagingConsent[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expires])
}

/// A signed-in browser or device (product rules section 15, Sessions). The JWT carries this row's id (`sid`); every
/// request checks that the row exists, belongs to the user, is not revoked and was made under the user's current
/// `sessionVersion`. `userAgent` is a short label ("Chrome on Windows"), never the full string; `ipPrefix` is the
/// first two octets of an IPv4 address or the first /48 of an IPv6 one, never the whole address.
model UserSession {
  id             String    @id @default(cuid())
  userId         String
  createdAt      DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  revokedAt      DateTime?
  sessionVersion Int       @default(0)
  userAgent      String    @default("")
  ipPrefix       String?
  method         String
  knownDeviceId  String?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  knownDevice KnownDevice? @relation(fields: [knownDeviceId], references: [id], onDelete: SetNull)

  @@index([userId, revokedAt, lastSeenAt])
  @@index([lastSeenAt])
  @@index([revokedAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

// ─── Tenants ─────────────────────────────────────────────────────────────────

enum OrganisationStatus {
  PENDING_REVIEW
  CHANGES_REQUESTED
  ACTIVE
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum OrganisationSource {
  SELF_SIGNUP
  SUPERADMIN
}

enum OrganisationVisibility {
  UNLISTED
  PUBLIC
}

enum PlanDurationType {
  /// A fixed number of months from the start date.
  ROLLING
  /// Ends on the last day of the organisation's financial year.
  ORG_YEAR
  /// Ends on one fixed date for everyone.
  FIXED_END
  LIFETIME
}

enum RejoinFeeRule {
  NEVER
  ONCE
  EACH_JOIN
  AFTER_LAPSE
}

enum JoinMode {
  OPEN
  APPROVAL
  INVITE_ONLY
  CLOSED
}

enum PaymentTiming {
  PAY_THEN_ACTIVATE
  ACTIVATE_THEN_CHARGE
}

/// How a plan is paid: nothing, online or in hand (the organisation's gateway if it has one), or in hand only.
enum PaymentMode {
  FREE
  ONLINE_OR_IN_HAND
  IN_HAND_ONLY
}

enum PlanFieldType {
  TEXT
  LONG_TEXT
  SELECT
  DATE
  EMAIL
  PHONE
  NUMBER
  CHECKBOX
  /// A choice from one of the organisation's groupings (PlanField.groupingId); saved as MemberGroupingValue rows.
  GROUPING
}

enum MemberSource {
  JOIN_FORM
  MANUAL
  IMPORT
}

enum TermStatus {
  PENDING_APPROVAL
  PENDING_PAYMENT
  UPCOMING
  ACTIVE
  GRACE
  ENDED
  LAPSED
  EXPIRED
  CANCELLED
  REJECTED
  REVOKED
}

enum TermKind {
  NEW
  RENEWAL
  REINSTATEMENT
}

enum OrganisationReviewAction {
  SUBMITTED
  RESUBMITTED
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  SUSPENDED
  REACTIVATED
  ARCHIVED
  CREATED
}

/// A tenant. Only ACTIVE organisations can run memberships; see organisationAllows in lib/permissions.ts.
model Organisation {
  id          String             @id @default(cuid())
  name        String
  slug        String             @unique
  description String             @default("")
  logoUrl     String?
  /// Organisation accent for its public pages (validated #RRGGBB).
  accentColor String?
  status      OrganisationStatus @default(PENDING_REVIEW)
  source      OrganisationSource @default(SELF_SIGNUP)
  /// Free-text kind, e.g. "Club", "Association", "Student society".
  kind        String             @default("")
  contactEmail String?
  /// Members can sign in to their own portal (memberships, payments, profile). Off: the organisation just keeps
  /// records; "Pay now" emails carry a secure pay link instead, and /verify still checks cards.
  memberPortal Boolean            @default(true)
  /// Playful touches (Patch, confetti, card tilt) on this organisation's member and public pages; staff can turn them off (CR-MOTION-01).
  delightEnabled Boolean          @default(true)
  /// Public ids for this organisation's optional outside analytics providers on its own public pages (product rules §8.2). Validated by lib/telemetry; never secrets.
  webTelemetry   Json?
  contactPhone String?
  addressLine String?
  city        String?
  /// Indian state/UT code (two letters, e.g. "KL"); also the GST supplier state.
  stateCode   String?
  postalCode  String?
  country     String             @default("IN")
  website     String?
  /// Month (1–12) the organisation's financial and membership year starts. India: April.
  financialYearStartMonth Int    @default(4)
  timezone    String             @default("Asia/Kolkata")
  currency    String             @default("INR")
  /// Set by the platform super-admin; null means the instance default.
  memberLimit  Int?
  managerLimit Int?
  /// Maker-checker for offline payments: the confirmer must differ from the recorder.
  offlineConfirmationRequired Boolean @default(false)
  /// Members may upload their own photo for their card from their account.
  memberPhotoUpload Boolean @default(false)
  /// PUBLIC organisations are listed at /organisations and take applications from anyone.
  visibility  OrganisationVisibility @default(UNLISTED)
  /// Names of the unit levels the organisation uses, top first, e.g. ["Region", "District", "Chapter"].
  unitLevels  String[]           @default([])
  /// Number formatting override, e.g. "en-IN"; null uses the currency's own locale.
  locale      String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  teamMembers   TeamMember[]
  teamInvites   TeamInvite[]
  staffRoles    OrgRole[]
  emailTemplates OrgEmailTemplate[]
  ownershipTransfers OwnershipTransfer[]
  reviews       OrganisationReview[]
  assets        Asset[]
  auditEvents   AuditEvent[]
  units         OrgUnit[]
  groupings     OrgGrouping[]
  groupingValues OrgGroupingValue[]
  memberGroupingValues MemberGroupingValue[]
  teamMemberScopes TeamMemberScope[]
  teamInviteScopes TeamInviteScope[]
  smartGroups   SmartGroup[]
  memberRoles   MemberRole[]
  plans         MembershipPlan[]
  members       Member[]
  terms         MembershipTerm[]
  counters      OrgCounter[]
  paymentSettings OrgPaymentSettings?
  taxSettings     OrgTaxSettings?
  payments        Payment[]
  refunds         Refund[]
  taxDocuments    TaxDocument[]
  documentCounters DocumentCounter[]
  cardDesigns   CardDesign[]
  cardTemplates CardTemplate[]
  cardBrandKit  CardBrandKit?
  memberCards   MemberCard[]
  certificateDesigns CertificateDesign[]
  certificates  Certificate[]
  cardExports   CardExportJob[]
  page          OrganisationPage?
  pageVersions  OrganisationPageVersion[]
  erasureRequests ErasureRequest[]
  dailyStats    OrgDailyStats[]
  ledgerEntries LedgerEntry[]
  openingBalances OpeningBalance[]
  refundRequests RefundRequest[]
  emailSettings  OrgEmailSettings?
  emailSuppressions EmailSuppression[]
  chatChannels   ChatChannel[]
  statsDirtyDays OrgStatsDirtyDay[]
  webVisits      WebVisitDaily[]
  messagingChannels MessagingChannel[]
  messagingSettings OrgMessagingSettings?
  whatsappTemplates WhatsAppTemplate[]
  notificationEndpoints NotificationEndpoint[]
  endpointChallenges NotificationEndpointChallenge[]
  messagingConsents MessagingConsent[]

  @@index([status, createdAt])
  @@index([visibility, status])
}

/// Append-only history of an organisation's application and lifecycle decisions.
model OrganisationReview {
  id             String                   @id @default(cuid())
  organisationId String
  action         OrganisationReviewAction
  actorUserId    String?
  /// Required for REJECTED and CHANGES_REQUESTED; shown to the applicant.
  reason         String?
  /// The application as submitted (name, contact, address, purpose…) at SUBMITTED/RESUBMITTED.
  applicationSnapshot Json?
  createdAt      DateTime                 @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([action, createdAt])
}

model TeamInvite {
  id              String   @id @default(cuid())
  organisationId  String
  token           String   @unique
  /// The nearest fixed role, still written so an update rollback works; `roleId` is what counts.
  role            TeamRole @default(VIEWER)
  roleId          String
  /// Set to give the role for one unit's subtree instead of the whole organisation.
  unitId          String?
  createdByUserId String?
  /// Set when the platform super-admin creates an organisation for someone: only this email may accept.
  email           String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime?
  usedAt          DateTime?
  usedByUserId    String?
  /// The one email an account was created for through this invite while new sign-ups were off (one account per invite).
  signupEmail     String?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  orgRole      OrgRole      @relation(fields: [organisationId, roleId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  unit         OrgUnit?     @relation(fields: [organisationId, unitId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  createdBy    User?        @relation("TeamInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  usedBy       User?        @relation("TeamInviteUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)
  scopes       TeamInviteScope[]

  @@unique([organisationId, id])
  @@index([organisationId])
  @@index([organisationId, roleId])
  @@index([organisationId, createdAt])
  @@index([expiresAt])
  @@index([usedAt])
}

/// A person on an organisation's team (managers and staff). Members of the organisation are `Member`.
model TeamMember {
  id             String   @id @default(cuid())
  userId         String
  organisationId String
  /// The nearest fixed role, still written so an update rollback works; `roleId` is what counts.
  role           TeamRole
  roleId         String
  /// Set to limit this person to one unit's subtree (members, payments and reports there only).
  unitId         String?
  /// Email this person a monthly summary of the organisation (their own unit when scoped).
  reportDigest   Boolean  @default(true)
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  orgRole      OrgRole      @relation(fields: [organisationId, roleId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  unit         OrgUnit?     @relation(fields: [organisationId, unitId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  /// Grouping limits, ANDed with the unit limit (lib/membership/scope.ts).
  scopes       TeamMemberScope[]

  @@unique([organisationId, id])
  @@unique([userId, organisationId])
  @@index([organisationId])
  @@index([organisationId, roleId])
}

/// A staff role an organisation defines: a name and permissions from the fixed list in lib/permissionRoles.ts. Where
/// someone holds it (the whole organisation or one unit's subtree) belongs to the grant: TeamMember.unitId.
model OrgRole {
  id             String    @id @default(cuid())
  organisationId String
  name           String
  description    String    @default("")
  capabilities   String[]  @default([])
  /// The organisation's one Owner role: every permission, never edited, archived or given by invite.
  isOwner        Boolean   @default(false)
  /// For the four starter roles, the fixed role each replaced. Lets a rolled-back release still give roles.
  starterKey     TeamRole?
  sortOrder      Int       @default(0)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  teamMembers  TeamMember[]
  invites      TeamInvite[]
  ownershipTransfers OwnershipTransfer[]

  @@unique([organisationId, id])
  @@unique([organisationId, name])
}

/// The owner offering the organisation to another staff member who holds their role for the whole organisation; it
/// moves when that person accepts. At most one open transfer per organisation (partial unique index, migration 0016).
model OwnershipTransfer {
  id             String    @id @default(cuid())
  organisationId String
  fromUserId     String
  toUserId       String
  /// The role the current owner keeps once the transfer is accepted.
  keepRoleId     String
  /// 32 random bytes, base64url: what the proposed owner accepts with.
  token          String    @unique
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?
  cancelledAt    DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  fromUser     User         @relation("OwnershipTransferFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser       User         @relation("OwnershipTransferTo", fields: [toUserId], references: [id], onDelete: Cascade)
  keepRole     OrgRole      @relation(fields: [organisationId, keepRoleId], references: [organisationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organisationId, createdAt])
  @@index([toUserId])
}

// ─── Operations ──────────────────────────────────────────────────────────────

model AuditEvent {
  id               String   @id @default(cuid())
  action           String
  actorUserId      String?
  organisationId   String?
  targetType       String?
  targetId         String?
  metadata         Json?
  createdAt        DateTime @default(now())

  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@index([organisationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model OutboxMessage {
  id          String       @id @default(cuid())
  kind        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  lockedAt    DateTime?
  sentAt      DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())

  @@index([status, availableAt])
  @@index([createdAt])
  @@index([status, sentAt])
}

/// One-row operational state for scheduled work, separate from the human audit trail.
model OperationalHeartbeat {
  key             String    @id
  lastStartedAt   DateTime?
  lastSucceededAt DateTime?
  lastSent        Int       @default(0)
  lastFailed      Int       @default(0)
  lastError       String?
  updatedAt       DateTime  @updatedAt
}

/// In-house page-visit counts (product rules §8.1): counts only, never people. No IP, user id, session id or URL.
/// organisationId is null for platform pages. NULLs are distinct in the composite unique index, so platform rows are
/// kept unique by the partial index WebVisitDaily_platform_key (migration 0022): upsert them with raw SQL
/// INSERT ... ON CONFLICT ("day","route","channel") WHERE "organisationId" IS NULL DO UPDATE.
model WebVisitDaily {
  id             String        @id @default(cuid())
  organisationId String?
  /// UTC day.
  day            DateTime      @db.Date
  /// Approved route template only, e.g. "/o/:orgSlug".
  route          String
  channel        String        @default("web")
  count          Int           @default(0)
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, day, route, channel])
  @@index([day])
}

/// Instance-wide, super-admin-managed controls. The singleton row is created on first change.
model InstanceSetting {
  id                    String   @id
  /// Public ids for optional outside analytics providers (product rules §8.2). Validated by lib/telemetry; never secrets.
  webTelemetry          Json?
  allowNewUserSignups   Boolean  @default(true)
  /// Self-service organisation applications (/start). Super-admins can always create organisations.
  allowOrganisationApplications Boolean @default(true)
  /// Sign-in method switches (one platform singleton). Each is an AND in front of that method's configuration:
  /// switching one on never makes an unconfigured method work, and switching one off never deletes credentials.
  /// passwordSignIn never applies to super admins, who always sign in with a password.
  /// Password is on by default; every other method is off until the operator switches it on (product rules §15).
  passwordSignIn        Boolean  @default(true)
  googleSignIn          Boolean  @default(false)
  appleSignIn           Boolean  @default(false)
  githubSignIn          Boolean  @default(false)
  supabaseSignIn        Boolean  @default(false)
  firebaseSignIn        Boolean  @default(false)
  /// Generic OIDC and SAML switches; each provider's own `enabled` flag is its switch (OidcProvider, SamlProvider).
  oidcSignIn            Boolean  @default(false)
  samlSignIn            Boolean  @default(false)
  /// Passkeys and phone codes: switches reserved now; the methods are not installed yet.
  passkeySignIn         Boolean  @default(false)
  phoneSignIn           Boolean  @default(false)
  emailFrom            String?
  smtpService           String?
  smtpHost              String?
  smtpPort              Int?
  smtpSecure            Boolean  @default(false)
  smtpUser              String?
  smtpPasswordEncrypted String?
  smtpAllowUnauthenticated Boolean @default(false)
  /// Outgoing email provider (product rules §16): smtp, ses, resend or postmark. Null: the environment decides.
  emailProvider         String?
  /// Encrypted JSON of the provider fields and secrets (lib/email/providerConfig.ts); never returned to the browser.
  emailProviderConfigEncrypted String?
  emailVerifiedAt       DateTime?
  emailLastError        String?
  /// Outgoing SMS provider (product rules §16): twilio or msg91. Null: the environment decides.
  smsProvider           String?
  /// Encrypted JSON of the SMS provider fields and secrets (lib/sms/config.ts); never returned to the browser.
  smsConfigEncrypted    String?
  smsVerifiedAt         DateTime?
  smsLastError          String?
  /// Organisations may send member messages through the platform's own channels when they have none of their own.
  messagingOrgsMayUsePlatform Boolean @default(true)
  googleClientId       String?
  googleClientSecretEncrypted String?
  githubClientId        String?
  githubClientSecretEncrypted String?
  /// Apple "Services ID", team id and key id; the .p8 private key is encrypted at rest.
  appleClientId         String?
  appleTeamId           String?
  appleKeyId            String?
  applePrivateKeyEncrypted String?
  backupProvider        String?
  backupLastSuccessAt   DateTime?
  backupRetentionDays   Int?
  updatedAt             DateTime @updatedAt
}

/// Stored files (Silo/S3/R2) for per-organisation storage accounting, or the database fallback.
model Asset {
  id             String   @id @default(cuid())
  organisationId String?
  /// Provider-specific object key (or path).
  key            String   @unique
  publicUrl      String?
  contentType    String?
  byteSize       BigInt?
  provider       String   @default("unknown")
  fileData       Bytes?
  createdAt      DateTime @default(now())

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([createdAt])
  @@index([provider])
}

/// A part of an organisation: a region, district, chapter or branch. `path` is the ancestor chain of ids
/// ("rootId/childId/thisId"), so a subtree is one prefix query. Archived, never deleted, once used.
model OrgUnit {
  id             String    @id @default(cuid())
  organisationId String
  parentId       String?
  name           String
  slug           String
  /// Short code (1 to 6 of A-Z and 0-9), unique per organisation: card numbers and join links use it.
  code           String
  /// How members of this unit pay offline (whom to pay, when, the UPI id). Empty: the nearest unit above's, then the
  /// organisation's offline instructions.
  paymentInstructions String @default("")
  /// The area's own contact details, printed on its members' card backs and shown on its area page. Each one left
  /// empty falls back to the nearest unit above, then the organisation (lib/units/contact.ts).
  contactEmail   String?
  contactPhone   String?
  website        String?
  /// 0 for top-level units; indexes Organisation.unitLevels.
  level          Int       @default(0)
  path           String
  sortOrder      Int       @default(0)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  parent       OrgUnit?     @relation("UnitTree", fields: [organisationId, parentId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  children     OrgUnit[]    @relation("UnitTree")
  members      Member[]
  roles        MemberRole[]
  planUnits    PlanUnit[]
  teamMembers  TeamMember[]
  teamInvites  TeamInvite[]
  dailyStats   OrgDailyStats[]
  cardDesigns  CardDesign[]

  @@unique([organisationId, id])
  @@unique([organisationId, slug])
  @@unique([organisationId, code])
  @@index([organisationId, path])
}

/// A role an organisation gives its members ("Secretary", "Systems Engineer"). Printed on member cards.
/// Distinct from team access roles (TeamRole).
model MemberRole {
  id             String    @id @default(cuid())
  organisationId String
  name           String
  description    String    @default("")
  /// One of the brand chip tones: teal, citron, sky, yellow, orange, ink.
  color          String    @default("teal")
  sortOrder      Int       @default(0)
  /// Optional: only offered for members of this unit's subtree.
  unitId         String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  unit         OrgUnit?     @relation(fields: [organisationId, unitId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  assignments  MemberRoleAssignment[]
  cardDesigns  CardDesign[]

  @@unique([organisationId, id])
  @@unique([organisationId, name])
}

model MembershipPlan {
  id                  String           @id @default(cuid())
  organisationId      String
  name                String
  slug                String
  description         String           @default("")
  /// ISO 4217; every price below is in this currency's minor units.
  currency            String           @default("INR")
  durationType        PlanDurationType @default(ORG_YEAR)
  durationMonths      Int?
  fixedEndDate        DateTime?
  priceNewMinor       Int              @default(0)
  priceRenewalMinor   Int              @default(0)
  joiningFeeMinor     Int              @default(0)
  rejoinFeeRule       RejoinFeeRule    @default(NEVER)
  rejoinAfterDays     Int?
  graceDays           Int              @default(15)
  renewalWindowDays   Int              @default(30)
  reminderDaysBefore  Int[]            @default([30, 7, 0])
  reminderDaysAfter   Int[]            @default([7])
  /// A late renewal starts at the old end date (true) or on the day it is paid (false).
  lateRenewalBackdate Boolean          @default(true)
  joinMode            JoinMode         @default(APPROVAL)
  joinPhoto           String           @default("OFF")
  joinFields          Json             @default("{}")
  paymentTiming       PaymentTiming    @default(PAY_THEN_ACTIVATE)
  paymentMode         PaymentMode      @default(ONLINE_OR_IN_HAND)
  /// Renewal conditions, validated by lib/membership/renewalPolicy.ts.
  renewalPolicy       Json             @default("{}")
  /// When false, only members of the units in PlanUnit may join.
  allUnits            Boolean          @default(true)
  sortOrder           Int              @default(0)
  archivedAt          DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  fields       PlanField[]
  units        PlanUnit[]
  terms        MembershipTerm[]
  invites      MemberInvite[]
  cardDesigns  CardDesign[]
  cards        MemberCard[]
  dailyStats   OrgDailyStats[]

  @@unique([organisationId, id])
  @@unique([organisationId, slug])
}

model PlanUnit {
  organisationId String
  planId         String
  unitId         String

  plan MembershipPlan @relation(fields: [organisationId, planId], references: [organisationId, id], onDelete: Cascade)
  unit OrgUnit        @relation(fields: [organisationId, unitId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([planId, unitId])
}

/// A question on a plan's join form. Answers live in Member.fieldValues under `key`.
model PlanField {
  id             String        @id @default(cuid())
  organisationId String
  planId         String
  key            String
  label          String
  helpText       String        @default("")
  type           PlanFieldType @default(TEXT)
  required       Boolean       @default(false)
  options        String[]      @default([])
  multiple       Boolean       @default(false)
  section        Boolean       @default(false)
  showIfKey      String?
  showIfValue    String?
  /// Only managers see and fill it; never on the public form.
  adminOnly      Boolean       @default(false)
  sortOrder      Int           @default(0)
  /// For GROUPING questions: the grouping the answer chooses from.
  groupingId     String?

  plan MembershipPlan @relation(fields: [organisationId, planId], references: [organisationId, id], onDelete: Cascade)
  grouping OrgGrouping? @relation(fields: [organisationId, groupingId], references: [organisationId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([planId, key])
}

/// One person in one organisation. Their membership periods are MembershipTerm rows.
model Member {
  id             String       @id @default(cuid())
  organisationId String
  /// The account that owns this record, once the person signs in with the same verified email.
  userId         String?
  email          String
  name           String
  phone          String?
  photoUrl       String?
  /// Indian state/UT code; place of supply on tax documents.
  stateCode      String?
  gstin          String?
  unitId         String?
  /// Per-organisation running number, from OrgCounter "member".
  memberNumber   Int
  fieldValues    Json         @default("{}")
  source         MemberSource @default(JOIN_FORM)
  isMinor        Boolean      @default(false)
  guardianName   String?
  guardianEmail  String?
  guardianPhone  String?
  notes          String       @default("")
  anonymisedAt   DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation Organisation           @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  unit         OrgUnit?               @relation(fields: [organisationId, unitId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  terms        MembershipTerm[]
  roles        MemberRoleAssignment[]
  consents     ConsentRecord[]
  payments     Payment[]
  refundRequests RefundRequest[]
  cards        MemberCard[]
  certificates Certificate[]
  erasureRequests ErasureRequest[]
  groupingValues MemberGroupingValue[]

  @@unique([organisationId, id])
  @@unique([organisationId, email])
  messageLogs MemberMessageLog[]
  @@unique([organisationId, memberNumber])
  @@index([userId])
  @@index([organisationId, unitId])
  @@index([organisationId, createdAt])
}

model MemberRoleAssignment {
  organisationId String
  memberId       String
  roleId         String
  /// The role printed on the member card. At most one per member.
  isPrimary      Boolean  @default(false)
  assignedAt     DateTime @default(now())

  member Member     @relation(fields: [organisationId, memberId], references: [organisationId, id], onDelete: Cascade)
  role   MemberRole @relation(fields: [organisationId, roleId], references: [organisationId, id], onDelete: Cascade)

  @@id([memberId, roleId])
  @@index([organisationId, roleId])
}

/// One membership period of one member on one plan. The status is a cache kept aligned by the sweep;
/// lib/membership/lifecycle.ts deriveStatus is the source of truth for display.
model MembershipTerm {
  id              String     @id @default(cuid())
  organisationId  String
  memberId        String
  planId          String
  status          TermStatus
  kind            TermKind   @default(NEW)
  startsAt        DateTime?
  endsAt          DateTime?
  graceUntil      DateTime?
  paymentDueBy    DateTime?
  /// Price frozen when the term was created, in the plan's currency at that time.
  currency        String
  priceMinor      Int
  joiningFeeMinor Int        @default(0)
  renewedFromId   String?
  decidedById     String?
  decidedAt       DateTime?
  reason          String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  member       Member            @relation(fields: [organisationId, memberId], references: [organisationId, id], onDelete: Cascade)
  plan         MembershipPlan    @relation(fields: [organisationId, planId], references: [organisationId, id], onDelete: Restrict)
  renewedFrom  MembershipTerm?   @relation("Renewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewals     MembershipTerm[]  @relation("Renewal")
  events       TermStatusEvent[]
  reminders    ReminderLog[]
  payments     Payment[]
  refundRequests RefundRequest[]

  @@unique([organisationId, id])
  @@index([organisationId, status, endsAt])
  @@index([status, endsAt])
  @@index([status, startsAt])
  @@index([status, graceUntil])
  @@index([status, paymentDueBy])
  @@index([renewedFromId, status])
  @@index([organisationId, createdAt])
  @@index([memberId, planId])
}

model TermStatusEvent {
  id             String      @id @default(cuid())
  organisationId String
  termId         String
  from           TermStatus?
  to             TermStatus
  /// Domain time of the change, e.g. the term's end date for an expiry the sweep records later.
  effectiveAt    DateTime
  recordedAt     DateTime    @default(now())
  actorUserId    String?
  cause          String

  term MembershipTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@index([termId, recordedAt])
  @@index([organisationId, effectiveAt])
}

/// A reminder sent for a term. The unique key makes each reminder go out once, however often the sweep runs.
model ReminderLog {
  termId String
  key    String
  sentAt DateTime @default(now())

  term MembershipTerm @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@id([termId, key])
}

model ConsentRecord {
  id             String    @id @default(cuid())
  organisationId String
  memberId       String
  purpose        String
  noticeVersion  String
  grantedAt      DateTime  @default(now())
  withdrawnAt    DateTime?
  byGuardian     Boolean   @default(false)

  member Member @relation(fields: [organisationId, memberId], references: [organisationId, id], onDelete: Cascade)

  @@index([memberId])
}

/// Gapless per-organisation counters ("member" numbers now; receipt series join in P7).
model OrgCounter {
  organisationId String
  name           String
  next           Int    @default(1)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([organisationId, name])
}

/// An invitation to join an INVITE_ONLY plan (any plan, in fact). Optionally bound to one email address.
model MemberInvite {
  id             String    @id @default(cuid())
  organisationId String
  planId         String
  token          String    @unique
  /// When set, only this verified email can use the invite.
  email          String?
  /// Optional preselected unit for whoever joins with it.
  unitId         String?
  /// Uses allowed; 1 for a personal invite, more for a shared link.
  maxUses        Int       @default(1)
  uses           Int       @default(0)
  createdById    String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?

  plan MembershipPlan @relation(fields: [organisationId, planId], references: [organisationId, id], onDelete: Cascade)

  @@index([organisationId, planId])
}

// ── Payments and tax documents (P7) ─────────────────────────────────────────

enum GatewayProvider {
  NONE
  RAZORPAY
  STRIPE
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  OFFLINE
}

enum PaymentStatus {
  PENDING
  AWAITING_CONFIRMATION
  PAID
  WAIVED
  FAILED
  CANCELLED
}

enum PaymentLineKind {
  TERM_FEE
  JOINING_FEE
  REJOIN_FEE
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum RefundPolicy {
  NONE
  FULL
  PRO_RATA
}

enum RefundRequestStatus {
  OPEN
  APPROVED
  DECLINED
  WITHDRAWN
}

enum TaxMode {
  GST
  SIMPLE
  NONE
}

enum GstScheme {
  REGULAR
  COMPOSITION
}

/// How a GST-registered organisation treats plans priced in other currencies.
enum ForeignCurrencyTax {
  EXPORT_LUT
  NO_TAX
}

enum TaxDocumentKind {
  RECEIPT
  TAX_INVOICE
  BILL_OF_SUPPLY
  CREDIT_NOTE
}

/// The organisation's payment gateway. Secrets are AES-GCM encrypted with PAYMENT_SECRETS_KEY.
model OrgPaymentSettings {
  organisationId         String          @id
  provider               GatewayProvider @default(NONE)
  /// Razorpay key id (public). Stripe needs only the secret key.
  keyId                  String?
  secretEncrypted        String?
  webhookSecretEncrypted String?
  /// Unguessable code in the webhook URL that identifies the organisation.
  webhookPublicCode      String          @unique
  testMode               Boolean         @default(true)
  verifiedAt             DateTime?
  upiVpa                 String?
  upiPayeeName           String?
  offlineInstructions    String          @default("")
  /// What members may get back when they cancel: nothing, everything, or the unused share of the fee.
  refundPolicy           RefundPolicy    @default(NONE)
  refundWindowDays       Int             @default(14)
  refundPolicyText       String          @default("")
  updatedAt              DateTime        @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

model OrgTaxSettings {
  organisationId     String             @id
  mode               TaxMode            @default(NONE)
  scheme             GstScheme          @default(REGULAR)
  gstin              String?
  legalName          String?
  address            String?
  /// Supplier state code; also the place-of-supply fallback.
  stateCode          String?
  sacCode            String             @default("999599")
  rateBps            Int                @default(1800)
  inclusive          Boolean            @default(true)
  exempt             Boolean            @default(false)
  foreignCurrencyTax ForeignCurrencyTax @default(NO_TAX)
  lutNumber          String?
  /// Name printed for SIMPLE mode, e.g. "VAT".
  simpleTaxName      String             @default("Tax")
  /// 0–4 uppercase letters or digits before every document number.
  receiptPrefix      String             @default("")
  updatedAt          DateTime           @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

model Payment {
  id               String          @id @default(cuid())
  organisationId   String
  memberId         String
  termId           String?
  status           PaymentStatus   @default(PENDING)
  provider         PaymentProvider
  /// upi, card, netbanking, wallet, cash, bank_transfer, cheque…
  method           String?
  currency         String
  amountMinor      Int
  /// Razorpay order id or Stripe Checkout Session id.
  gatewayOrderId   String?
  /// Razorpay payment id or Stripe PaymentIntent id.
  gatewayPaymentId String?
  settlementId     String?
  utr              String?
  reference        String?
  note             String          @default("")
  paidAt           DateTime?
  recordedById     String?
  confirmedById    String?
  /// The member said "I've paid" (a UTR claim), rather than staff recording money they took.
  memberClaim      Boolean         @default(false)
  /// Set when a captured payment needs a manager's attention (late, mismatched, duplicate).
  flaggedAt        DateTime?
  flagReason       String?
  /// The tax document waits for review (amount mismatch).
  documentHeld     Boolean         @default(false)
  capturedMinor    Int?
  /// Tax configuration frozen when the payment was created.
  taxSnapshot      Json
  anonymisedAt     DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  member       Member          @relation(fields: [organisationId, memberId], references: [organisationId, id], onDelete: Restrict)
  term         MembershipTerm? @relation(fields: [organisationId, termId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  lines        PaymentLine[]
  refunds      Refund[]
  documents    TaxDocument[]
  refundRequests RefundRequest[]

  @@unique([organisationId, id])
  @@unique([provider, gatewayOrderId])
  @@index([organisationId, status, createdAt])
  @@index([organisationId, paidAt])
  @@index([organisationId, memberId])
  @@index([termId])
}

model PaymentLine {
  id             String          @id @default(cuid())
  organisationId String
  paymentId      String
  kind           PaymentLineKind
  description    String
  currency       String
  amountMinor    Int
  taxableMinor   Int
  cgstMinor      Int             @default(0)
  sgstMinor      Int             @default(0)
  igstMinor      Int             @default(0)
  otherTaxMinor  Int             @default(0)

  payment Payment @relation(fields: [organisationId, paymentId], references: [organisationId, id], onDelete: Restrict)

  @@index([paymentId])
}

/// Webhook idempotency: a provider event is applied once.
model ProcessedWebhookEvent {
  provider       PaymentProvider
  eventId        String
  organisationId String
  receivedAt     DateTime        @default(now())

  @@id([provider, eventId])
  @@index([organisationId, receivedAt])
}

model Refund {
  id              String       @id @default(cuid())
  organisationId  String
  paymentId       String
  status          RefundStatus @default(PENDING)
  currency        String
  amountMinor     Int
  reason          String       @default("")
  gatewayRefundId String?      @unique
  createdById     String?
  failureReason   String?
  createdAt       DateTime     @default(now())
  processedAt     DateTime?
  /// When the scheduler last asked the gateway about this pending refund.
  lastCheckedAt   DateTime?
  request         RefundRequest?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  payment      Payment      @relation(fields: [organisationId, paymentId], references: [organisationId, id], onDelete: Restrict)
  document     TaxDocument?

  @@unique([organisationId, id])
  @@index([organisationId, createdAt])
  @@index([paymentId])
}

/// Receipts, tax invoices, bills of supply and credit notes. The PDF is rendered from `snapshot`.
model TaxDocument {
  id              String          @id @default(cuid())
  organisationId  String
  paymentId       String?
  refundId        String?         @unique
  kind            TaxDocumentKind
  /// "R" for payment documents, "C" for credit notes.
  series          String
  /// "2026-27" in the organisation's financial year.
  financialYear   String
  sequence        Int
  number          String
  currency        String
  totalMinor      Int
  taxableMinor    Int
  cgstMinor       Int             @default(0)
  sgstMinor       Int             @default(0)
  igstMinor       Int             @default(0)
  otherTaxMinor   Int             @default(0)
  placeOfSupply   String?
  sac             String?
  snapshot        Json
  templateVersion Int             @default(1)
  issuedAt        DateTime        @default(now())
  cancelledAt     DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  payment      Payment?     @relation(fields: [organisationId, paymentId], references: [organisationId, id], onDelete: Restrict, onUpdate: Restrict)
  refund       Refund?      @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@unique([organisationId, number])
  @@unique([organisationId, series, financialYear, sequence])
  @@index([organisationId, issuedAt])
  @@index([paymentId])
}

/// Gapless document numbering per organisation, series and financial year.
model DocumentCounter {
  organisationId String
  series         String
  financialYear  String
  next           Int    @default(1)

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([organisationId, series, financialYear])
}

// ─── Member cards ────────────────────────────────────────────────────────────

/// A member card design: the organisation default (planId and roleId null), one plan's own, or one member
/// role's own. A card uses its member's primary role design, else its plan's, else the organisation's.
/// Managers edit `draft`; only the owner approves it, which copies it into the live columns (`design`,
/// numbering, watermark) that every member's card is drawn from (lib/cards/approval.ts).
model CardDesign {
  id             String   @id @default(cuid())
  organisationId String
  planId         String?
  roleId         String?
  /// An area design: members of this unit and every unit below it, unless a nearer unit has its own.
  /// At most one of planId, roleId and unitId is set (CHECK in migration 0029).
  unitId         String?
  /// The approved front and back (lib/cards/design/presets.ts normalises it on every read); null until
  /// the first approval, and the row is ignored until then.
  design         Json?
  /// Changes waiting for the owner's approval: { design, numberPrefix, numberFormat, watermarkUrl }.
  draft          Json?
  draftUpdatedById String?
  draftUpdatedAt   DateTime?
  approvedById   String?
  approvedAt     DateTime?
  /// Prefix of printed card numbers, e.g. "SWO" in SWO-0042. Read from the organisation default, role and
  /// area designs only (lib/cards/numbering.ts).
  numberPrefix   String
  /// Card number pattern, e.g. "{PREFIX}-{SEQ:4}". Read from the organisation default, role and area designs.
  numberFormat   String   @default("{PREFIX}-{SEQ:4}")
  /// Watermark image (a managed upload) for designs that use one.
  watermarkUrl   String?
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  plan         MembershipPlan? @relation(fields: [organisationId, planId], references: [organisationId, id], onDelete: Cascade)
  role         MemberRole?     @relation(fields: [organisationId, roleId], references: [organisationId, id], onDelete: Cascade)
  unit         OrgUnit?        @relation(fields: [organisationId, unitId], references: [organisationId, id], onDelete: Cascade)
  versions     CardDesignVersion[]

  @@unique([organisationId, id])
  @@unique([organisationId, planId])
  @@unique([organisationId, roleId])
  @@unique([organisationId, unitId])
}

/// A saved state of a card design (lib/cards/versions.ts): DRAFT snapshots are coalesced to one per 10 minutes,
/// every approval is kept as APPROVED, and each design keeps its 30 newest.
model CardDesignVersion {
  id             String   @id @default(cuid())
  organisationId String
  cardDesignId   String
  /// DRAFT or APPROVED.
  kind           String
  design         Json
  numberPrefix   String
  numberFormat   String
  createdById    String?
  createdAt      DateTime @default(now())

  cardDesign CardDesign @relation(fields: [organisationId, cardDesignId], references: [organisationId, id], onDelete: Cascade)

  @@index([organisationId, cardDesignId, createdAt])
}

/// An organisation's own card template (app/actions/card-templates.ts): both sides, at most 50 per organisation.
model CardTemplate {
  id             String   @id @default(cuid())
  organisationId String
  /// 1 to 60 characters.
  name           String
  design         Json
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, createdAt])
}

/// A member's card for one plan. The verify token sits in the QR and is unguessable; renewals keep the
/// card and its QR, because /verify reads the membership live. Reissuing revokes the old card and issues
/// a new token, so an old QR stops verifying.
model MemberCard {
  id             String    @id @default(cuid())
  organisationId String
  memberId       String
  planId         String
  cardNumber     String
  /// 32 random bytes, base64url. Treat as a bearer value: never log it.
  verifyToken    String    @unique
  issuedAt       DateTime  @default(now())
  issuedById     String?
  revokedAt      DateTime?
  revokedById    String?
  /// REISSUED (replaced by a newer card), REVOKED (by a manager) or MEMBERSHIP_ENDED.
  revokedReason  String?
  lastEmailedAt  DateTime?

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  member       Member         @relation(fields: [organisationId, memberId], references: [organisationId, id], onDelete: Cascade)
  plan         MembershipPlan @relation(fields: [organisationId, planId], references: [organisationId, id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([memberId, planId])
  @@index([organisationId, issuedAt])
  @@index([organisationId, cardNumber])
}

/// A certificate type with its own design (lib/certificates/*): appreciation, completion, office bearer, anything the
/// organisation names. `design` is one card side in the card layer model at page size, normalised on every read;
/// null until the owner's first approval. `draft` waits for approval, like a card design.
model CertificateDesign {
  id             String    @id @default(cuid())
  organisationId String
  name           String
  /// What the certificate is called when none is typed at issue: "Certificate of appreciation".
  typeLabel      String
  /// A4 or LETTER; the live design's page. The draft carries its own.
  pageSize       String    @default("A4")
  /// LANDSCAPE or PORTRAIT.
  orientation    String    @default("LANDSCAPE")
  design         Json?
  /// { design, numberPrefix, numberFormat, pageSize, orientation, typeLabel }.
  draft          Json?
  draftUpdatedById String?
  draftUpdatedAt   DateTime?
  approvedById   String?
  approvedAt     DateTime?
  numberPrefix   String
  numberFormat   String    @default("{PREFIX}-{SEQ:4}")
  archivedAt     DateTime?
  createdById    String?
  updatedById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  certificates Certificate[]

  @@unique([organisationId, id])
  @@index([organisationId, archivedAt])
}

/// One certificate given to a member. The verify token sits in the QR and is unguessable. Certificates are drawn on
/// demand from the design's live version and never stored; revoking keeps the row and shows it as revoked.
model Certificate {
  id                String    @id @default(cuid())
  organisationId    String
  designId          String
  memberId          String
  certificateNumber String
  /// 32 random bytes, base64url. Treat as a bearer value: never log it.
  verifyToken       String    @unique
  title             String
  reason            String?
  issuedAt          DateTime  @default(now())
  issuedById        String?
  revokedAt         DateTime?
  revokedById       String?
  revokedReason     String?
  emailedAt         DateTime?

  organisation Organisation      @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  design       CertificateDesign @relation(fields: [organisationId, designId], references: [organisationId, id], onDelete: Restrict)
  member       Member            @relation(fields: [organisationId, memberId], references: [organisationId, id], onDelete: Cascade)

  @@unique([organisationId, id])
  @@unique([organisationId, certificateNumber])
  @@index([organisationId, designId, issuedAt])
  @@index([organisationId, memberId])
}

enum CardExportStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// A bulk card export (one PDF, or a ZIP of PDFs) built in the background and stored privately.
model CardExportJob {
  id             String           @id @default(cuid())
  organisationId String
  requestedById  String?
  /// "sheet" (A4 sheets with crop marks), "cards" (one card per page) or "zip" (one PDF per member).
  format         String
  /// The member filter chosen on the members page, plus the requester's unit scope.
  filter         Json
  status         CardExportStatus @default(PENDING)
  attempts       Int              @default(0)
  cardCount      Int?
  storageKey     String?
  byteSize       Int?
  error          String?
  lockedAt       DateTime?
  createdAt      DateTime         @default(now())
  finishedAt     DateTime?
  /// The file is deleted after this; the row stays as a record of the export.
  expiresAt      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([organisationId, createdAt])
}

// ─── Member portal and public page (P8) ─────────────────────────────────────

/**
 * The organisation's public page at /o/[slug]. The columns hold what is published; `draft` holds unpublished
 * edits in the same shape (lib/publicPage/sections.ts). With no publishedAt the plain page shows.
 */
model OrganisationPage {
  organisationId String    @id
  tagline        String    @default("")
  /// Storage key of the cover image (organisations/<id>/page-images/<uuid>.webp).
  coverAssetKey  String?
  /// Validated #RRGGBB; null uses the organisation's accent.
  accentColor    String?
  sections       Json      @default("[]")
  publishedAt    DateTime?
  draft          Json?
  /// Who published what is live.
  publishedById  String?
  /// When and by whom the draft was last saved (autosave).
  draftSavedAt   DateTime?
  draftSavedById String?
  updatedById    String?
  updatedAt      DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

/// A published version of the public page, newest 20 kept per organisation (lib/publicPage/server.ts). Restoring one copies it into the draft.
model OrganisationPageVersion {
  id             String   @id @default(cuid())
  organisationId String
  /// The whole page document as published (lib/publicPage/sections.ts).
  document       Json
  publishedAt    DateTime
  publishedById  String?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, publishedAt(sort: Desc)])
}

enum ErasureStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/**
 * A member asking an organisation to erase their details. A manager approves (the member is anonymised;
 * money rows stay) or rejects with a note.
 */
model ErasureRequest {
  id                String        @id @default(cuid())
  organisationId    String
  memberId          String
  /// The account that asked; its email gets the decision.
  requestedByUserId String?
  status            ErasureStatus @default(PENDING)
  reason            String        @default("")
  decidedById       String?
  decidedAt         DateTime?
  decisionNote      String?
  createdAt         DateTime      @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  member       Member       @relation(fields: [organisationId, memberId], references: [organisationId, id], onDelete: Cascade)

  @@unique([organisationId, id])
  @@index([organisationId, status, createdAt])
  @@index([memberId])
}

// ─── Reports ─────────────────────────────────────────────────────────────────

/// Daily membership numbers per organisation, unit and plan, written by the sweep (lib/reports/rollup.ts)
/// and defined in docs/REPORTS.md. `day` is the organisation's local calendar day. `planId` null is the
/// all-plans row (distinct members); `unitId` null is members without a unit. Every day is recomputable
/// from source rows: the rollup deletes and rewrites a whole (organisation, day).
model OrgDailyStats {
  id             String   @id @default(cuid())
  organisationId String
  day            DateTime @db.Date
  unitId         String?
  planId         String?
  /// Stocks at the end of the day.
  active         Int      @default(0)
  grace          Int      @default(0)
  /// Members whose last membership ended (lapsed or expired) and who hold no live one.
  expired        Int      @default(0)
  /// Flows during the day.
  joined         Int      @default(0)
  reactivated    Int      @default(0)
  due            Int      @default(0)
  renewed        Int      @default(0)
  lapsed         Int      @default(0)
  applications   Int      @default(0)
  computedAt     DateTime @default(now())

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  unit         OrgUnit?        @relation(fields: [organisationId, unitId], references: [organisationId, id], onDelete: Cascade, onUpdate: Restrict)
  plan         MembershipPlan? @relation(fields: [organisationId, planId], references: [organisationId, id], onDelete: Cascade, onUpdate: Restrict)

  @@index([organisationId, day])
  @@index([day])
}

/// Days whose rollup must be rebuilt (a backdated change touched them). The next sweep rebuilds and clears them.
model OrgStatsDirtyDay {
  organisationId String
  day            DateTime @db.Date
  markedAt       DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([organisationId, day])
}

// ── Accounts: the organisation's own receipts and payments (owner, 2026-10-20) ──

enum LedgerDirection {
  RECEIPT
  PAYMENT
}

/// Money in or out that isn't a member's payment: donations, grants, rent, equipment, GST paid and so on.
/// Membership fees and refunds come from the payments tables. Entries are never deleted; a mistake is voided.
model LedgerEntry {
  id             String          @id @default(cuid())
  organisationId String
  direction      LedgerDirection
  /// The day the money moved, as a calendar date in the organisation's timezone (stored at UTC midnight).
  occurredOn     DateTime        @db.Date
  category       String
  /// Who paid it (receipts) or who was paid (payments).
  party          String          @default("")
  description    String          @default("")
  currency       String
  amountMinor    Int
  /// cash, bank_transfer, upi, cheque, card or other: cash moves the cash balance, everything else the bank.
  method         String
  reference      String?
  recordedById   String?
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  createdAt      DateTime        @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, occurredOn])
}

/// Cash in hand and at the bank at the start of a financial year, per currency, as the accounts carried forward.
model OpeningBalance {
  organisationId String
  financialYear  String
  currency       String
  cashMinor      Int      @default(0)
  bankMinor      Int      @default(0)
  updatedById    String?
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([organisationId, financialYear, currency])
}

/// A member asking for their money back, which also asks to end the membership. A manager approves (refund
/// plus cancellation) or declines; the member may withdraw while it is open. One open request per payment.
model RefundRequest {
  id                String              @id @default(cuid())
  organisationId    String
  paymentId         String
  termId            String
  memberId          String
  requestedByUserId String?
  reason            String
  status            RefundRequestStatus @default(OPEN)
  /// What the policy offered when the member asked; the manager may approve another amount.
  suggestedMinor    Int
  currency          String
  decidedById       String?
  decidedAt         DateTime?
  decisionNote      String?
  refundId          String?             @unique
  createdAt         DateTime            @default(now())

  organisation Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  payment      Payment        @relation(fields: [organisationId, paymentId], references: [organisationId, id], onDelete: Restrict)
  term         MembershipTerm @relation(fields: [organisationId, termId], references: [organisationId, id], onDelete: Restrict)
  member       Member         @relation(fields: [organisationId, memberId], references: [organisationId, id], onDelete: Restrict)
  refund       Refund?        @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@unique([organisationId, id])
  @@index([organisationId, status, createdAt])
  @@index([paymentId])
}

/// An organisation's own outgoing email for member emails. Without it (or while disabled) member emails go
/// through the platform's SMTP, sent as the organisation's name with replies to its contact email. Account
/// emails (password reset, verification) always use the platform's.
model OrgEmailSettings {
  organisationId        String    @id
  enabled               Boolean   @default(false)
  fromName              String    @default("")
  fromAddress           String?
  replyTo               String?
  smtpHost              String?
  smtpPort              Int       @default(587)
  /// Implicit TLS (port 465); otherwise STARTTLS is required in production.
  smtpSecure            Boolean   @default(false)
  smtpUser              String?
  smtpPasswordEncrypted String?
  /// smtp, ses, resend or postmark; the provider fields live encrypted in providerConfigEncrypted.
  emailProvider         String    @default("smtp")
  providerConfigEncrypted String?
  verifiedAt            DateTime?
  updatedAt             DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

enum ChatChannelKind {
  SLACK
  DISCORD
  MATTERMOST
  TELEGRAM
  WHATSAPP
  WEBHOOK
}

enum EmailSuppressionReason {
  BOUNCE
  COMPLAINT
}

/// Addresses a provider reported as bounced or complained about; sends skip them. organisationId null is the
/// platform account's list; an organisation with its own provider keeps its own (lib/email/suppression.ts).
model EmailSuppression {
  id             String                 @id @default(cuid())
  organisationId String?
  address        String
  reason         EmailSuppressionReason
  provider       String
  createdAt      DateTime               @default(now())

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, address])
  @@index([createdAt])
}

/// A chat destination for team alerts. Webhook URLs, bot tokens and WhatsApp credentials live encrypted in
/// `configEncrypted`; `target` is a safe, non-secret description for the settings page.
model ChatChannel {
  id              String          @id @default(cuid())
  organisationId  String
  kind            ChatChannelKind
  name            String
  configEncrypted String
  target          String          @default("")
  events          String[]
  includeNames    Boolean         @default(false)
  enabled         Boolean         @default(true)
  lastDeliveredAt DateTime?
  lastError       String?
  failures        Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, id])
  @@index([organisationId])
}

/// A browser that has signed in to an account before, recognised by a long-lived cookie stored only as a hash.
/// A sign-in from anywhere else needs an emailed code (accounts without an authenticator) and sends an alert.
/// A WebAuthn credential a person registered from a signed-in session. Only the public key is stored.
model Passkey {
  id           String    @id @default(cuid())
  userId       String
  /// Base64url credential id.
  credentialId String    @unique
  publicKey    Bytes
  /// The authenticator's signature counter; 0 for authenticators that do not count.
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  /// "singleDevice" or "multiDevice".
  deviceType   String
  backedUp     Boolean   @default(false)
  name         String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A short-lived, single-use WebAuthn challenge: `reg:<userId>` for registration, `sin:<hash of cookie token>` for sign-in.
model PasskeyChallenge {
  id        String   @id @default(cuid())
  key       String   @unique
  kind      String
  challenge String
  expiresAt DateTime

  @@index([expiresAt])
}

model KnownDevice {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  label       String   @default("")
  lastIp      String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userSessions UserSession[]

  @@index([userId, lastSeenAt])
}

/// An organisation's own wording for one member-facing email (`kind`, e.g. "card-issued", "membership-activated").
/// Plain text with {placeholders}, rendered as escaped paragraphs; without a row the platform's wording is used.
model OrgEmailTemplate {
  organisationId String
  kind           String
  subject        String
  heading        String
  body           String
  /// Short text for SMS, WhatsApp, Telegram, Slack, Discord and Mattermost; empty uses the standard short text.
  shortText      String   @default("")
  updatedById    String?
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@id([organisationId, kind])
}

// ── Sign-in and identity (D1a, product rules §15) ─────────────────────────────

/// An operator-level OpenID Connect provider. The client secret is write-only (encrypted like other instance secrets).
model OidcProvider {
  id                    String   @id @default(cuid())
  /// Lowercase letters, digits and hyphens. The Auth.js provider id and Account.provider are "oidc:<id>" (this row's id, never the slug); callbacks are /api/auth/callback/oidc:<id>.
  slug                  String   @unique
  name                  String
  /// https issuer; its discovery document is fetched at sign-in.
  issuer                String
  clientId              String
  clientSecretEncrypted String
  scopes                String   @default("openid email profile")
  enabled               Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// An operator-level SAML 2.0 identity provider (service-provider side only). The certificate is the IdP's public key.
model SamlProvider {
  id                    String   @id @default(cuid())
  slug                  String   @unique
  name                  String
  /// The IdP's entity id (issuer of its assertions).
  entityId              String
  ssoUrl                String
  idpCertificate        String   @db.Text
  /// Our entity id towards this IdP; defaults to the metadata URL when empty.
  spEntityId            String?
  enabled               Boolean  @default(false)
  wantAssertionsSigned  Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  loginStates           SamlLoginState[]
}

/// Short-lived, single-use SAML state: "request" rows hold an AuthnRequest id (checked as InResponseTo); "ticket" rows
/// hold the validated identity between the ACS route and Auth.js, keyed by the sha256 of a random ticket.
model SamlLoginState {
  id          String       @id @default(cuid())
  kind        String
  /// Request id, or the ticket's sha256.
  key         String       @unique
  providerId  String
  /// Request: the validated same-site callback path. Ticket: { email, name, subject }.
  payload     Json
  expiresAt   DateTime
  provider    SamlProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

/// One phone code (sign-in or number verification), or the record that one was asked for. Rows are also the send log
/// the per-number and per-country limits count, so a request for a number with no account leaves one too (no `userId`,
/// no code, nothing sent). The number is kept only as an HMAC; the code only as an HMAC. Purged after two days.
model SmsCode {
  id            String    @id @default(cuid())
  /// SIGN_IN or VERIFY.
  purpose       String
  userId        String?
  phoneHash     String
  /// The country calling code (digits), for the per-country daily cap.
  country       String
  codeHash      String?
  attempts      Int       @default(0)
  expiresAt     DateTime
  consumedAt    DateTime?
  /// The provider's message id once it accepted the send; the idempotency guard and the delivery report's key.
  providerRef   String?
  /// queued, sent, delivered, undelivered or failed, from the provider's delivery report.
  deliveryState String?
  /// The provider's error code (a number or short word), never a number or a message.
  deliveryError String?
  createdAt     DateTime  @default(now())

  @@index([createdAt])
  @@index([phoneHash, createdAt])
  @@index([country, createdAt])
  @@index([providerRef])
  @@index([expiresAt])
}

/// An extra way an organisation divides its members beyond the unit tree ("Profession", "Region"). A list or a tree
/// of values; members choose values on the join form; staff can be limited to values (TeamMemberScope).
model OrgGrouping {
  id             String    @id @default(cuid())
  organisationId String
  /// Lowercase key, unique per organisation (used by imports and exports).
  key            String
  name           String
  /// "list" or "tree" (values may have parents).
  kind           String    @default("list")
  /// A member may hold several values of this grouping.
  multiple       Boolean   @default(false)
  sortOrder      Int       @default(0)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  values       OrgGroupingValue[]
  memberValues MemberGroupingValue[]
  teamScopes   TeamMemberScope[]
  inviteScopes TeamInviteScope[]
  planFields   PlanField[]

  @@unique([organisationId, id])
  @@unique([organisationId, key])
}

model OrgGroupingValue {
  id             String    @id @default(cuid())
  organisationId String
  groupingId     String
  parentId       String?
  label          String
  /// 1 to 12 of A-Z and 0-9, unique within the grouping (imports and filters).
  code           String
  /// Ancestor ids joined by "/", ending with this value's own id (like OrgUnit.path).
  path           String
  level          Int       @default(0)
  sortOrder      Int       @default(0)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  grouping     OrgGrouping           @relation(fields: [organisationId, groupingId], references: [organisationId, id], onDelete: Cascade)
  parent       OrgGroupingValue?     @relation("GroupingValueTree", fields: [organisationId, parentId], references: [organisationId, id], onDelete: NoAction, onUpdate: NoAction)
  children     OrgGroupingValue[]    @relation("GroupingValueTree")
  memberValues MemberGroupingValue[]
  teamScopes   TeamMemberScope[]
  inviteScopes TeamInviteScope[]

  @@unique([organisationId, id])
  @@unique([organisationId, groupingId, id])
  @@unique([groupingId, code])
  @@index([organisationId, groupingId, path])
}

/// One value a member holds in one grouping. Written only through lib/groupings/memberValues.ts.
model MemberGroupingValue {
  id             String   @id @default(cuid())
  organisationId String
  memberId       String
  groupingId     String
  valueId        String
  createdAt      DateTime @default(now())

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  member       Member           @relation(fields: [organisationId, memberId], references: [organisationId, id], onDelete: Cascade)
  grouping     OrgGrouping      @relation(fields: [organisationId, groupingId], references: [organisationId, id], onDelete: Cascade)
  value        OrgGroupingValue @relation(fields: [organisationId, groupingId, valueId], references: [organisationId, groupingId, id], onDelete: Cascade)

  @@unique([memberId, valueId])
  @@index([organisationId, groupingId, valueId])
  @@index([memberId])
}

/// Limits a team member to a grouping value's subtree. Several rows for one grouping widen it (OR); different
/// groupings and the unit limit narrow it (AND).
model TeamMemberScope {
  id             String   @id @default(cuid())
  organisationId String
  teamMemberId   String
  groupingId     String
  valueId        String
  createdAt      DateTime @default(now())

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  teamMember   TeamMember       @relation(fields: [organisationId, teamMemberId], references: [organisationId, id], onDelete: Cascade)
  grouping     OrgGrouping      @relation(fields: [organisationId, groupingId], references: [organisationId, id], onDelete: NoAction, onUpdate: NoAction)
  value        OrgGroupingValue @relation(fields: [organisationId, groupingId, valueId], references: [organisationId, groupingId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([teamMemberId, valueId])
  @@index([organisationId, teamMemberId])
}

model TeamInviteScope {
  id             String   @id @default(cuid())
  organisationId String
  teamInviteId   String
  groupingId     String
  valueId        String
  createdAt      DateTime @default(now())

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  teamInvite   TeamInvite       @relation(fields: [organisationId, teamInviteId], references: [organisationId, id], onDelete: Cascade)
  grouping     OrgGrouping      @relation(fields: [organisationId, groupingId], references: [organisationId, id], onDelete: NoAction, onUpdate: NoAction)
  value        OrgGroupingValue @relation(fields: [organisationId, groupingId, valueId], references: [organisationId, groupingId, id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([teamInviteId, valueId])
  @@index([organisationId, teamInviteId])
}

/// A saved condition over members (lib/groups/conditions.ts). Computed on demand, never stored per member.
model SmartGroup {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  description    String   @default("")
  /// A condition tree validated by smartGroupConditionSchema.
  condition      Json
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([organisationId, id])
  @@unique([organisationId, name])
}

/// A member-message channel's connection: the platform's (organisationId null) or an organisation's own. Secrets are
/// encrypted in configEncrypted and never returned to the browser. SMS at platform level lives in InstanceSetting.
model MessagingChannel {
  id              String    @id @default(cuid())
  organisationId  String?
  /// SMS, WHATSAPP, TELEGRAM, SLACK, DISCORD or MATTERMOST.
  channel         String
  provider        String
  configEncrypted String
  enabled         Boolean   @default(true)
  verifiedAt      DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, channel])
}

/// Per-organisation routing (kind to ordered channels) and quiet hours (minutes after midnight, organisation timezone).
model OrgMessagingSettings {
  organisationId   String    @id
  routing          Json      @default("{}")
  quietStartMinute Int?
  quietEndMinute   Int?
  lastDigestOn     DateTime? @db.Date
  updatedAt        DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}

/// The approved WhatsApp template a message kind uses in one language, with the ordered placeholder names that fill it.
model WhatsAppTemplate {
  id             String   @id @default(cuid())
  organisationId String?
  kind           String
  language       String
  name           String
  variables      String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([organisationId, kind, language])
}

/// A person's verified address on a channel, in the scope of the bot or sender that reaches it (organisationId null: the platform's).
model NotificationEndpoint {
  id                String    @id @default(cuid())
  userId            String
  organisationId    String?
  channel           String
  /// HMAC of the identity: uniqueness without storing it in the clear.
  identityDigest    String
  /// The identity needed to send, encrypted.
  identityEncrypted String
  verifiedAt        DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A one-time code that links a chat account (or proves a phone) to a person. Only the keyed hash is stored.
model NotificationEndpointChallenge {
  id             String    @id
  userId         String
  organisationId String?
  channel        String
  codeHash       String
  attempts       Int       @default(0)
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// A person's choice, per organisation and channel: OPTED_IN, or STOPPED (a STOP reply or the stop link).
model MessagingConsent {
  organisationId String
  userId         String
  channel        String
  status         String
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organisationId, userId, channel])
}

/// One row per member message, once per dedupe key: what was sent and through which channel. No text, number or address.
model MemberMessageLog {
  id             String   @id @default(cuid())
  organisationId String
  memberId       String
  kind           String
  dedupeKey      String
  status         String   @default("PENDING")
  channel        String?
  /// Channels that refused this message for good, so a retry moves on to the next one.
  refused        String[]
  providerRef    String?
  deliveryState  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  member Member @relation(fields: [organisationId, memberId], references: [organisationId, id], onDelete: Cascade)

  @@unique([organisationId, memberId, dedupeKey])
  @@index([providerRef])
  @@index([createdAt])
}

/// An organisation's brand kit for the card designer: logo variants (its own `organisation-logos` uploads), up to
/// 12 colours and up to 4 card fonts. `kit` is normalised on every read and write (lib/cards/brandKit.ts).
model CardBrandKit {
  organisationId String   @id
  kit            Json     @default("{}")
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
}
